//@version=5
strategy(title = "SMC & ICT + Smart Trade Research Strategy"
  , overlay = true, max_labels_count = 500, max_lines_count = 500
  , max_boxes_count = 500, max_bars_back = 5000, pyramiding = 0
  , initial_capital = 100000, default_qty_type = strategy.fixed
  , commission_type = strategy.commission.percent, commission_value = 0
  , slippage = 0, process_orders_on_close = true
  , calc_on_order_fills = false, calc_on_every_tick = false
  , use_bar_magnifier = false, margin_long = 100, margin_short = 100)
//-----------------------------------------------------------------------------{
//Constants
//-----------------------------------------------------------------------------{
color TRANSP_CSS = #ffffff00

// Appearance
// Pine cannot read the TradingView chart theme automatically. This selector
// changes only this indicator's palette; switch the chart background separately.
indicator_theme = input.string('Dark', 'Indicator Theme'
  , options = ['Dark', 'Light']
  , group = 'Appearance'
  , tooltip = 'Choose Dark for a black/dark chart or Light for a white/light chart. Pine cannot detect the TradingView chart theme automatically.', display = display.none)

use_theme_palette = input.bool(true, 'Use Theme Palette'
  , group = 'Appearance'
  , tooltip = 'When enabled, the selected theme supplies high-contrast colors. Disable it to use the custom color inputs in each module.', display = display.none)

show_marker_tooltips = input.bool(true, 'Show Signal Hover Names'
  , group = 'Marker Layout'
  , tooltip = 'Show the short signal name when the mouse hovers over a pivot S/R arrow or triangle.', display = display.none)

marker_base_atr = input.float(0.45, 'Marker Distance From Candle (ATR)'
  , minval = 0.10
  , maxval = 2.00
  , step = 0.05
  , group = 'Marker Layout'
  , tooltip = 'Keeps the first pivot S/R signal marker away from candles and SMC swing labels such as HH, LH, HL, and LL.', display = display.none)

marker_lane_atr = input.float(0.35, 'Marker Lane Spacing (ATR)'
  , minval = 0.10
  , maxval = 2.00
  , step = 0.05
  , group = 'Marker Layout'
  , tooltip = 'Adds another vertical lane when multiple pivot S/R signals occur on the same candle, preventing their symbols from overlapping.', display = display.none)

is_light_theme = indicator_theme == 'Light'
color theme_bull_css = is_light_theme ? #007C91 : #22D3EE
color theme_bear_css = is_light_theme ? #B45309 : #FBBF24
color theme_bull_zone_css = is_light_theme ? color.new(#15803D, 82) : color.new(#22C55E, 82)
color theme_bear_zone_css = is_light_theme ? color.new(#B91C1C, 82) : color.new(#EF4444, 82)
color theme_bull_border_css = is_light_theme ? #15803D : #4ADE80
color theme_bear_border_css = is_light_theme ? #B91C1C : #F87171
color theme_level_css = is_light_theme ? #1D4ED8 : #60A5FA
color theme_neutral_css = is_light_theme ? #334155 : #CBD5E1
color theme_neutral_dark_css = is_light_theme ? #64748B : #64748B
color theme_text_css = is_light_theme ? #111827 : #F8FAFC
color theme_transparent_css = color.new(theme_text_css, 100)
color dashboard_bull_css = is_light_theme ? #15803D : #166534
color dashboard_bear_css = is_light_theme ? #B91C1C : #991B1B
color dashboard_wait_css = is_light_theme ? #1D4ED8 : #1E40AF
color dashboard_header_css = is_light_theme ? #6B21A8 : #581C87
color dashboard_text_css = #FFFFFF

// Semantic signal colors. Each pivot signal keeps its own color so markers on
// the same resistance/support side remain distinguishable at a glance.
color theme_breakout_css = is_light_theme ? #2563EB : #60A5FA
color theme_breakdown_css = is_light_theme ? #DC2626 : #F87171
color theme_res_break_css = is_light_theme ? #16A34A : #4ADE80
color theme_sup_break_css = is_light_theme ? #EA580C : #FB923C
color theme_false_breakup_css = is_light_theme ? #7C3AED : #C084FC
color theme_false_breakdown_css = is_light_theme ? #CA8A04 : #FACC15
color theme_bull_reaction_css = is_light_theme ? #0891B2 : #22D3EE
color theme_bear_reaction_css = is_light_theme ? #DB2777 : #F472B6
color theme_bull_tsi_css = is_light_theme ? #0F766E : #2DD4BF
color theme_bear_tsi_css = is_light_theme ? #6D28D9 : #A78BFA

//Tooltips
string MODE_TOOLTIP          = 'Allows to display historical Structure or only the recent ones'
string STYLE_TOOLTIP         = 'Indicator color theme'
string COLOR_CANDLES_TOOLTIP = 'Display additional candles with a color reflecting the current trend detected by structure'
string SHOW_INTERNAL         = 'Display internal market structure'
string CONFLUENCE_FILTER     = 'Filter non significant internal structure breakouts'
string SHOW_SWING            = 'Display swing market Structure'
string SHOW_SWING_POINTS     = 'Display swing point as labels on the chart'
string SHOW_SWHL_POINTS      = 'Highlight most recent strong and weak high/low points on the chart'
string INTERNAL_OB           = 'Display internal order blocks on the chart\n\nNumber of internal order blocks to display on the chart'
string SWING_OB              = 'Display swing order blocks on the chart\n\nNumber of internal swing blocks to display on the chart'
string FILTER_OB             = 'Method used to filter out volatile order blocks \n\nIt is recommended to use the cumulative mean range method when a low amount of data is available'
string SHOW_EQHL             = 'Display equal highs and equal lows on the chart'
string EQHL_BARS             = 'Number of bars used to confirm equal highs and equal lows'
string EQHL_THRESHOLD        = 'Sensitivity threshold in a range (0, 1) used for the detection of equal highs & lows\n\nLower values will return fewer but more pertinent results'
string SHOW_FVG              = 'Display fair values gaps on the chart'
string AUTO_FVG              = 'Filter out non significant fair value gaps'
string FVG_TF                = 'Fair value gaps timeframe'
string EXTEND_FVG            = 'Determine how many bars to extend the Fair Value Gap boxes on chart'
string PED_ZONES             = 'Display premium, discount, and equilibrium zones on chart'

