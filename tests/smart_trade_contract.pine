//@version=5
indicator("Smart Trade Contract Tests", overlay=true)
// Generated from the production modules: do not edit this file.
st_risk = 10.0
st_pip = 0.1
st_cost_pips = 4.0
st_stop_model = 'Fixed 100 pips'
st_min_stop_pips = 20.0
st_max_stop_pips = 500.0
st_stop_buffer = 0.5
st_target_buffer = 0.2
st_merge = 0.5
st_chase_r = 0.75
st_risk_cash = 100000.0
st_qty_step = 0.001
st_target_mode = 'Structure'
st_stop_mode = 'Fixed original stop'
st_expiry = 240
st_confirm_window = 30
st_confirmation_anchor = 'Internal swing'
type STZone
    int id
    int side
    int origin
    int born
    float top
    float bottom
    float rawTop
    float rawBottom
    int state = 0
    int touched = na
    float trigger = na
    float extreme = na
    bool bulb = false
    string reason = 'Available'
    box drawing = na
    bool fresh = true
    bool valid = true
    int bornTime = na
    int selectedTime = na
    int touchTime = na
    int confirmedTime = na

type STLevel
    int side
    float nearPrice
    float farPrice
    string source
    int born

type STTrade
    int side = 0
    int born = na
    float entry = na
    float stop = na
    float tp1 = na
    float tp2 = na
    float qty = na
    float remaining = 1.0
    float gross = 0.0
    bool partial = false
    bool ambiguous = false
    bool completedTP2 = false
    float initialRisk = na // Frozen price distance; survives a breakeven move.

var st_zones = array.new<STZone>()
var st_levels = array.new<STLevel>()
var st_labels = array.new_label()
var st_boxes = array.new_box()
var st_lines = array.new_line()
var st_events = array.new_int(2, 0) // capacity rejections, closed trade count

st_target_pair(int side, float entry) =>
    candidates = array.new<STLevel>()
    distances = array.new_float()
    for level in st_levels
        if level.side == side and (level.nearPrice - entry) * side > 0
            array.push(candidates, level)
            array.push(distances, (level.nearPrice - entry) * side)
    for zone in st_zones
        if zone.side == -side and zone.valid
            nearPrice = side == 1 ? zone.bottom : zone.top
            farPrice = side == 1 ? zone.top : zone.bottom
            if (nearPrice - entry) * side > 0
                zoneName = (side == 1 ? 'Supply' : 'Demand') + (zone.fresh ? ' (fresh)' : ' (tested)')
                array.push(candidates, STLevel.new(side, nearPrice, farPrice, zoneName, zone.born))
                array.push(distances, (nearPrice - entry) * side)
    float first = na
    float second = na
    float clusterFar = na
    string firstName = ''
    string secondName = ''
    sorted = array.sort_indices(distances, order.ascending)
    for index in sorted
        level = array.get(candidates, index)
        if na(first)
            first := level.nearPrice
            firstName := level.source
            clusterFar := level.farPrice * side
        else if level.nearPrice * side <= clusterFar + st_merge
            clusterFar := math.max(clusterFar, level.farPrice * side)
        else
            second := level.nearPrice
            secondName := level.source
            break
    // Round toward entry so tick rounding cannot manufacture extra reward.
    t1 = na(first) ? na : (side == 1 ? math.floor((first - st_target_buffer) / syminfo.mintick) : math.ceil((first + st_target_buffer) / syminfo.mintick)) * syminfo.mintick
    t2 = na(second) ? na : (side == 1 ? math.floor((second - st_target_buffer) / syminfo.mintick) : math.ceil((second + st_target_buffer) / syminfo.mintick)) * syminfo.mintick
    [t1, t2, firstName, secondName]

st_plan(int side, float entry, float invalidation, float proximal, bool baseline) =>
    [first, second, firstName, secondName] = st_target_pair(side, entry)
    sl = math.round_to_mintick(entry - side * st_risk)
    structural = st_stop_model == 'Structure + buffer'
    if structural
        distance = math.max((entry - invalidation) * side + st_stop_buffer, st_min_stop_pips * st_pip)
        rawStop = entry - side * distance
        // Round away from entry to preserve the full structural buffer.
        sl := (side == 1 ? math.floor(rawStop / syminfo.mintick) : math.ceil(rawStop / syminfo.mintick)) * syminfo.mintick
    risk = (entry - sl) * side
    rr = (first - entry) * side / risk
    qty = syminfo.pointvalue > 0 and risk > 0 ? math.floor(st_risk_cash / (risk * syminfo.pointvalue) / (2 * st_qty_step)) * (2 * st_qty_step) : 0.0
    string reason = ''
    bool insideOpposing = false
    for zone in st_zones
        if zone.side == -side and zone.valid and entry >= zone.bottom and entry <= zone.top
            insideOpposing := true
    if insideOpposing
        reason := 'Entry inside opposing Demand/Supply'
    else if na(invalidation) or na(risk) or risk <= 0 or (invalidation - sl) * side < st_stop_buffer - syminfo.mintick * 0.0001
        reason := structural ? 'Invalid structural stop' : '100-pip SL fails structure'
    else if structural and (st_min_stop_pips > st_max_stop_pips or risk > st_max_stop_pips * st_pip + syminfo.mintick * 0.0001)
        reason := 'Structural stop exceeds maximum'
    else if not baseline and (entry - proximal) * side > st_chase_r * risk
        reason := 'Confirmation too far from area'
    else if na(first)
        reason := 'No TP1'
    else if rr < 2.0 - 0.0000001
        reason := 'Nearest TP1 below 2R'
    else if na(second) or (second - first) * side <= st_merge
        reason := 'No distinct TP2'
    else if qty <= 0
        reason := 'Quantity too small for two exits'
    else if array.get(st_events, 0) > 0
        reason := 'Registry capacity: fail closed'
    if st_target_mode == 'Fixed 2R / 3R benchmark'
        first := math.round_to_mintick(entry + side * 2 * risk)
        second := math.round_to_mintick(entry + side * 3 * risk)
        firstName := 'Fixed 2R benchmark'
        secondName := 'Fixed 3R benchmark'
    [sl, first, second, qty, reason, firstName, secondName]

st_prepare_trade_bar(STTrade trade) =>
    // TP1 is only known after its candle has completed in this close-based
    // model. Activate breakeven on the following candle so the experiment
    // cannot retroactively improve the intrabar TP1 outcome.
    if trade.side != 0 and trade.partial and st_stop_mode == 'Breakeven after TP1 (next bar)'
        trade.stop := trade.entry

st_trade_risk(STTrade trade) =>
    // Legacy synthetic fixtures may omit the snapshot; real entries set it.
    nz(trade.initialRisk, st_risk)

st_cost_r(float risk) =>
    st_cost_pips * st_pip / risk

st_process_point(STTrade trade, float price, bool gap) =>
    if trade.side != 0
        if (price - trade.stop) * trade.side <= 0
            fillPrice = gap ? price : trade.stop
            trade.gross += trade.remaining * (fillPrice - trade.entry) * trade.side / st_trade_risk(trade)
            trade.remaining := 0.0
            trade.side := 0
        else
            if not trade.partial and (price - trade.tp1) * trade.side >= 0
                fillPrice = gap ? price : trade.tp1
                fillSize = st_stop_mode == 'Close full at TP1' ? trade.remaining : 0.5
                trade.gross += fillSize * (fillPrice - trade.entry) * trade.side / st_trade_risk(trade)
                trade.remaining := st_stop_mode == 'Close full at TP1' ? 0.0 : 0.5
                trade.partial := true
                if st_stop_mode == 'Close full at TP1'
                    trade.side := 0
            if trade.side != 0 and (price - trade.tp2) * trade.side >= 0
                fillPrice = gap ? price : trade.tp2
                trade.gross += trade.remaining * (fillPrice - trade.entry) * trade.side / st_trade_risk(trade)
                trade.remaining := 0.0
                trade.side := 0
                trade.completedTP2 := true

// Pure lifecycle transition over an existing snapshot. Keeping OHLC, bias,
// time and structural anchors explicit makes the production rules testable.

st_step_zone(STZone z, int idx, int closedAt, float hi, float lo, float cl, float prevClose, int bias, float priorHigh, float priorLow, float rsi) =>
    bool touchEvent = false
    if idx > z.born
        crossed = z.side == 1 ? cl < z.rawBottom : cl > z.rawTop
        touchedNow = z.side == 1 ? lo <= z.top : hi >= z.bottom
        z.fresh := z.fresh and not touchedNow
        z.valid := z.valid and not crossed and idx - z.born <= st_expiry
        if z.state <= 2
            if crossed
                z.state := 4
                z.reason := 'Invalidated'
            else if idx - z.born > st_expiry
                z.state := 5
                z.reason := 'Expired'
            else if z.state > 0 and (na(bias) or bias != z.side)
                z.state := 6
                z.reason := 'HTF bias no longer aligned'
            else if z.state == 0 and touchedNow
                z.state := 7
                z.reason := 'Tested before selection'
            else if z.state == 1 and touchedNow
                z.state := 2
                z.touched := idx
                z.touchTime := closedAt
                z.trigger := st_confirmation_anchor == 'Touch candle break' ? (z.side == 1 ? hi : lo) : (z.side == 1 ? priorHigh : priorLow)
                z.extreme := z.side == 1 ? math.min(z.rawBottom, lo) : math.max(z.rawTop, hi)
                z.bulb := z.side == 1 ? rsi <= 30 : rsi >= 65
                z.reason := 'Touched: awaiting close break'
                touchEvent := true
                if na(z.trigger)
                    z.state := 6
                    z.reason := 'No confirmed internal swing'
                // A touch that closes back through the anchor resets the
                // break. Its later reclaim is a valid post-touch confirmation,
                // even when the candle before the touch was beyond the anchor.
                else if z.side == 1 ? prevClose > z.trigger and cl > z.trigger : prevClose < z.trigger and cl < z.trigger
                    z.state := 6
                    z.reason := 'Structure already broken before touch'
            else if z.state == 2
                z.extreme := z.side == 1 ? math.min(z.extreme, lo) : math.max(z.extreme, hi)
                z.bulb := z.bulb or (z.side == 1 ? rsi <= 30 : rsi >= 65)
                if idx - z.touched > st_confirm_window
                    z.state := 5
                    z.reason := 'Confirmation expired'
    touchEvent

st_zone_confirmable(STZone z, int idx, float cl, float rsi, bool requireBulb) =>
    broken = z.side == 1 ? cl > z.trigger and cl > z.top : cl < z.trigger and cl < z.bottom
    recovered = z.side == 1 ? rsi > 30 : rsi < 65
    z.state == 2 and idx > z.touched and broken and (not requireBulb or (z.bulb and recovered))

// Synthetic cases invoke the EXACT production target, risk and fill functions.
// These are code-behaviour tests, not evidence of trading profitability.
st_assert(bool condition, string name) =>
    if na(condition) or not condition
        runtime.error('SMART TRADE CONTRACT FAILED: ' + name)

st_near(float actual, float expected) =>
    math.abs(actual - expected) <= math.max(syminfo.mintick * 1.1, 0.000001)

if barstate.isfirst
    [eSL, e1, e2, eQ, eWhy, eS1, eS2] = st_plan(1, 100, 95, 99, false)
    st_assert(eWhy == 'No TP1', 'empty target registry fails closed')
    array.push(st_levels, STLevel.new(1, 135.2, 135.2, 'far', 0))
    array.push(st_levels, STLevel.new(1, 122.4, 122.4, 'duplicate cluster', 0))
    array.push(st_levels, STLevel.new(1, 122.2, 122.2, 'nearest', 0))
    [sl, t1, t2, q, why, src1, src2] = st_plan(1, 100, 95, 99, false)
    st_assert(why == '', 'valid long passes')
    st_assert(st_near(sl, 90), 'fixed 100 pip long stop')
    st_assert(st_near(t1, 122) and st_near(t2, 135), 'sort cluster and buffer')
    st_assert(src1 == 'nearest' and src2 == 'far', 'source identities retained')
    // Decimal quantity steps are binary floats; exact modulo equality can
    // fail for a correctly rounded quantity. Check integer step count instead.
    halfSteps = q / (2 * st_qty_step)
    st_assert(q > 0 and math.abs(halfSteps - math.round(halfSteps)) < 0.000001, 'quantity supports exact half exits')
    array.push(st_levels, STLevel.new(1, 115.2, 115.2, 'near obstacle', 0))
    [csl, c1, c2, cq, cwhy, cs1, cs2] = st_plan(1, 100, 95, 99, false)
    st_assert(cwhy == 'Nearest TP1 below 2R', 'never skip closer obstacle')
    array.pop(st_levels)
    [bsl, b1, b2, bq, bwhy, bs1, bs2] = st_plan(1, 100, 89, 99, false)
    st_assert(bwhy == '100-pip SL fails structure', 'stop cannot be inside invalidation')
    [xsl, x1, x2, xq, xwhy, xs1, xs2] = st_plan(1, 100, 95, 80, false)
    st_assert(xwhy == 'Confirmation too far from area', 'no late chase')
    array.clear(st_levels)
    array.push(st_levels, STLevel.new(-1, 77.8, 77.8, 'near low', 0))
    array.push(st_levels, STLevel.new(-1, 64.8, 64.8, 'far low', 0))
    [ssl, s1, s2, sq, swhy, ss1, ss2] = st_plan(-1, 100, 105, 101, false)
    st_assert(swhy == '' and st_near(ssl, 110), 'short stop mirror')
    st_assert(st_near(s1, 78) and st_near(s2, 65), 'short buffered target mirror')
    array.pop(st_levels)
    [nsl, n1, n2, nq, nwhy, ns1, ns2] = st_plan(-1, 100, 105, 101, false)
    st_assert(nwhy == 'No distinct TP2', 'missing second target rejected')
    array.clear(st_levels)
    z = STZone.new(1, -1, 1, 1, 101, 99, 101, 99)
    array.push(st_zones, z)
    [isl, i1, i2, iq, iwhy, is1, is2] = st_plan(1, 100, 95, 99, false)
    st_assert(iwhy == 'Entry inside opposing Demand/Supply', 'inside opposing zone veto')
    z.top := 116
    z.bottom := 115
    z.fresh := false
    z.state := 6
    [v1, v2, vn1, vn2] = st_target_pair(1, 100)
    st_assert(st_near(v1, 114.8), 'tested or bias-rejected zone remains an obstacle')
    z.valid := false
    [iv1, iv2, ivn1, ivn2] = st_target_pair(1, 100)
    st_assert(na(iv1), 'invalidated zone excluded')
    array.clear(st_zones)
    trade = STTrade.new(1, 0, 100, 90, 122, 135, 10)
    st_process_point(trade, 122, false)
    st_assert(trade.partial and st_near(trade.gross, 1.1) and trade.remaining == 0.5, 'TP1 accounts for half only')
    st_prepare_trade_bar(trade)
    st_assert(st_near(trade.stop, 90), 'default keeps original stop after TP1')
    st_process_point(trade, 90, false)
    st_assert(trade.side == 0 and st_near(trade.gross, 0.6), 'TP1 then original stop = 0.6R')
    st_process_point(trade, 150, false)
    st_assert(st_near(trade.gross, 0.6), 'closed trade never pays twice')
    winner = STTrade.new(1, 0, 100, 90, 122, 135, 10)
    st_process_point(winner, 140, false)
    st_assert(winner.completedTP2 and st_near(winner.gross, 2.85), 'two targets weighted correctly')
    st_stop_mode := 'Close full at TP1'
    scalp = STTrade.new(1, 0, 100, 90, 122, 135, 10)
    st_process_point(scalp, 122, false)
    st_assert(scalp.side == 0 and scalp.partial and st_near(scalp.gross, 2.2) and scalp.remaining == 0, 'full TP1 exit frees the next setup')
    st_stop_mode := 'Fixed original stop'
    gapLoser = STTrade.new(1, 0, 100, 90, 122, 135, 10)
    st_process_point(gapLoser, 80, true)
    st_assert(st_near(gapLoser.gross, -2), 'gap loss is not falsely capped at 1R')
    gapWinner = STTrade.new(1, 0, 100, 90, 122, 135, 10)
    st_process_point(gapWinner, 140, true)
    st_assert(st_near(gapWinner.gross, 4), 'favourable gap fills at open')
    shortWinner = STTrade.new(-1, 0, 100, 110, 78, 65, 10)
    st_process_point(shortWinner, 60, false)
    st_assert(st_near(shortWinner.gross, 2.85), 'short exit accounting mirror')
    st_stop_mode := 'Breakeven after TP1 (next bar)'
    beTrade = STTrade.new(1, 0, 100, 90, 122, 135, 10)
    st_process_point(beTrade, 122, false)
    st_prepare_trade_bar(beTrade)
    st_assert(st_near(beTrade.stop, 100), 'breakeven moves remaining stop after TP1')
    untouchedStop = STTrade.new(1, 0, 100, 90, 122, 135, 10)
    st_prepare_trade_bar(untouchedStop)
    st_assert(st_near(untouchedStop.stop, 90), 'breakeven cannot move stop before TP1')
    st_stop_mode := 'Fixed original stop'
    area = STZone.new(7, 1, 1000, 10, 100, 95, 100, 94)
    area.state := 1
    st_step_zone(area, 10, 10000, 102, 94, 99, 101, 1, 103, 92, 29)
    st_assert(area.state == 1 and area.fresh, 'birth candle cannot touch')
    st_step_zone(area, 11, 11000, 102, 94, 99, 101, 1, 103, 92, 29)
    st_assert(area.state == 2 and area.touched == 11 and area.touchTime == 11000, 'future touch captured')
    st_assert(not st_zone_confirmable(area, 11, 104, 40, false), 'same touch bar cannot confirm')
    st_step_zone(area, 12, 12000, 106, 93, 104, 99, 1, 108, 92, 40)
    st_assert(st_near(area.trigger, 103) and st_near(area.extreme, 93), 'trigger frozen and worst wick tracked')
    st_assert(st_zone_confirmable(area, 12, 104, 40, true), 'bulb recovery with later close confirms')
    st_assert(not st_zone_confirmable(area, 12, 104, 29, true), 'unrecovered bulb does not confirm')
    area.state := 3
    st_step_zone(area, 13, 13000, 107, 96, 105, 104, 1, 106, 92, 40)
    st_assert(not st_zone_confirmable(area, 13, 105, 40, false) and area.state == 3, 'used area never rearms')
    st_assert(area.id == 7 and area.top == 100 and area.bottom == 95, 'identity and geometry immutable')
    untouched = STZone.new(8, 1, 2000, 10, 100, 95, 100, 94)
    st_step_zone(untouched, 11, 11000, 102, 99, 101, 102, 1, 103, 92, 40)
    st_assert(untouched.state == 7 and not untouched.fresh, 'unselected first touch consumes freshness')
    invalid = STZone.new(9, 1, 3000, 10, 100, 95, 100, 94)
    invalid.state := 1
    st_step_zone(invalid, 11, 11000, 105, 90, 93, 102, 1, 103, 92, 40)
    st_assert(invalid.state == 4 and not invalid.valid and na(invalid.touched), 'close invalidation precedes touch')
    expired = STZone.new(10, 1, 4000, 10, 100, 95, 100, 94)
    expired.state := 1
    st_step_zone(expired, 251, 251000, 106, 104, 105, 104, 1, 110, 92, 40)
    st_assert(expired.state == 5 and not expired.valid, 'zone age expires')
    biasChanged = STZone.new(11, 1, 5000, 10, 100, 95, 100, 94)
    biasChanged.state := 1
    st_step_zone(biasChanged, 11, 11000, 106, 104, 105, 104, -1, 110, 92, 40)
    st_assert(biasChanged.state == 6 and biasChanged.valid and biasChanged.fresh, 'bias cancellation does not erase market obstacle')
    noAnchor = STZone.new(12, 1, 6000, 10, 100, 95, 100, 94)
    noAnchor.state := 1
    st_step_zone(noAnchor, 11, 11000, 102, 99, 101, 102, 1, na, 92, 40)
    st_assert(noAnchor.state == 6, 'missing confirmed anchor rejected')
    oldBreak = STZone.new(13, 1, 7000, 10, 100, 95, 100, 94)
    oldBreak.state := 1
    st_step_zone(oldBreak, 11, 11000, 105, 99, 104, 104, 1, 103, 92, 40)
    st_assert(oldBreak.state == 6, 'break before touch not confirmation')
    reclaim = STZone.new(16, 1, 10000, 10, 100, 95, 100, 94)
    reclaim.state := 1
    st_step_zone(reclaim, 11, 11000, 105, 99, 101, 104, 1, 103, 92, 40)
    st_assert(reclaim.state == 2 and not st_zone_confirmable(reclaim, 11, 104, 40, false), 'touch resets old bullish break without same-bar entry')
    st_step_zone(reclaim, 12, 12000, 105, 100, 104, 101, 1, 110, 92, 40)
    st_assert(st_zone_confirmable(reclaim, 12, 104, 40, false) and reclaim.trigger == 103, 'later bullish reclaim uses frozen anchor')
    shortReclaim = STZone.new(17, -1, 11000, 10, 105, 100, 106, 100)
    shortReclaim.state := 1
    st_step_zone(shortReclaim, 11, 11000, 101, 95, 99, 96, -1, 110, 97, 50)
    st_assert(shortReclaim.state == 2 and not st_zone_confirmable(shortReclaim, 11, 96, 50, false), 'touch resets old bearish break without same-bar entry')
    st_step_zone(shortReclaim, 12, 12000, 100, 95, 96, 99, -1, 110, 90, 50)
    st_assert(st_zone_confirmable(shortReclaim, 12, 96, 50, false) and shortReclaim.trigger == 97, 'later bearish reclaim uses frozen anchor')
    timedOut = STZone.new(14, 1, 8000, 10, 100, 95, 100, 94)
    timedOut.state := 1
    st_step_zone(timedOut, 11, 11000, 102, 99, 101, 102, 1, 103, 92, 40)
    st_step_zone(timedOut, 24, 24000, 106, 101, 104, 101, 1, 105, 92, 40)
    st_assert(timedOut.state == 5 and not st_zone_confirmable(timedOut, 24, 104, 40, false), 'confirmation timeout precedes signal')
    shortArea = STZone.new(15, -1, 9000, 10, 105, 100, 106, 100)
    shortArea.state := 1
    st_step_zone(shortArea, 11, 11000, 101, 98, 99, 98, -1, 110, 97, 70)
    st_step_zone(shortArea, 12, 12000, 101, 95, 96, 99, -1, 110, 93, 50)
    st_assert(st_zone_confirmable(shortArea, 12, 96, 50, true), 'short touch and confirmation mirror')
    st_assert(st_near(shortArea.extreme, 106) and st_near(shortArea.trigger, 97), 'short wick and trigger retained')

    // A separate risk experiment: actual structure determines R and quantity.
    array.clear(st_zones)
    array.clear(st_levels)
    array.push(st_levels, STLevel.new(1, 115.2, 115.2, 'near', 0))
    array.push(st_levels, STLevel.new(1, 125.2, 125.2, 'far', 0))
    st_stop_model := 'Structure + buffer'
    [asl, a1, a2, aq, awhy, as1, as2] = st_plan(1, 100, 95, 99, false)
    st_assert(awhy == '' and st_near(asl, 94.5), 'structural long clears wick plus buffer')
    st_assert(aq * (100 - asl) * syminfo.pointvalue <= st_risk_cash + 0.0001, 'adaptive size respects cash risk')
    st_assert((100 - asl) * syminfo.pointvalue * (aq + 2 * st_qty_step) > st_risk_cash, 'adaptive quantity rounds down by exact half-exit increments')
    [msl, m1, m2, mq, mwhy, ms1, ms2] = st_plan(1, 100, 99, 99, false)
    st_assert(mwhy == '' and st_near(msl, 98), 'minimum stop prevents tiny risk distance')
    [wsl, w1, w2, wq, wwhy, ws1, ws2] = st_plan(1, 100, 40, 99, false)
    st_assert(wwhy == 'Structural stop exceeds maximum', 'wide structural stop rejected')
    [zsl, z1, z2, zq, zwhy, zs1, zs2] = st_plan(1, 100, na, 99, false)
    st_assert(zwhy == 'Invalid structural stop', 'missing structural invalidation rejected')
    array.push(st_levels, STLevel.new(1, 105.2, 105.2, 'closer obstacle', 0))
    [osl, o1, o2, oq, owhy, os1, os2] = st_plan(1, 100, 95, 99, false)
    st_assert(owhy == 'Nearest TP1 below 2R', 'adaptive mode still respects closest obstacle')
    array.pop(st_levels)
    st_target_mode := 'Fixed 2R / 3R benchmark'
    [fsl, f1, f2, fq, fwhy, fs1, fs2] = st_plan(1, 100, 95, 99, false)
    st_assert(fwhy == '' and st_near(f1, 111) and st_near(f2, 116.5), 'benchmark uses actual stop distance')
    st_target_mode := 'Structure'
    array.clear(st_levels)
    array.push(st_levels, STLevel.new(-1, 84.8, 84.8, 'near', 0))
    array.push(st_levels, STLevel.new(-1, 74.8, 74.8, 'far', 0))
    [hsl, h1, h2, hq, hwhy, hs1, hs2] = st_plan(-1, 100, 105, 101, false)
    st_assert(hwhy == '' and st_near(hsl, 105.5), 'structural short mirror')
    adaptiveTrade = STTrade.new(1, 0, 100, 95, 110, 115, 10)
    adaptiveTrade.initialRisk := 5
    st_process_point(adaptiveTrade, 110, false)
    st_assert(st_near(adaptiveTrade.gross, 1), 'adaptive TP1 accounts in frozen R')
    st_stop_mode := 'Breakeven after TP1 (next bar)'
    st_prepare_trade_bar(adaptiveTrade)
    st_process_point(adaptiveTrade, 100, false)
    st_assert(adaptiveTrade.side == 0 and st_near(adaptiveTrade.gross, 1) and st_trade_risk(adaptiveTrade) == 5, 'breakeven preserves initial R denominator')
    adaptiveGap = STTrade.new(-1, 0, 100, 120, 60, 40, 10)
    adaptiveGap.initialRisk := 20
    st_process_point(adaptiveGap, 130, true)
    st_assert(st_near(adaptiveGap.gross, -1.5), 'adaptive gap loss uses actual risk')
    st_assert(math.abs(st_cost_r(5) - 0.08) < 0.000001 and math.abs(st_cost_r(20) - 0.02) < 0.000001, 'pip costs scale with individual stop distance')
    st_stop_mode := 'Fixed original stop'
    st_stop_model := 'Fixed 100 pips'

    st_confirmation_anchor := 'Touch candle break'
    fastLong = STZone.new(18, 1, 12000, 10, 100, 95, 100, 94)
    fastLong.state := 1
    st_step_zone(fastLong, 11, 11000, 102, 98, 101, 103, 1, 120, 90, 40)
    st_assert(fastLong.state == 2 and fastLong.trigger == 102 and not st_zone_confirmable(fastLong, 11, 103, 40, false), 'touch high frozen without same-bar entry')
    st_step_zone(fastLong, 12, 12000, 104, 100, 103, 101, 1, 125, 90, 40)
    st_assert(st_zone_confirmable(fastLong, 12, 103, 40, false) and fastLong.trigger == 102, 'later touch-high break qualifies before distant swing')
    fastShort = STZone.new(19, -1, 13000, 10, 105, 100, 106, 100)
    fastShort.state := 1
    st_step_zone(fastShort, 11, 11000, 102, 98, 99, 97, -1, 120, 80, 50)
    st_assert(fastShort.state == 2 and fastShort.trigger == 98 and not st_zone_confirmable(fastShort, 11, 97, 50, false), 'touch low frozen without same-bar entry')
    st_step_zone(fastShort, 12, 12000, 100, 96, 97, 99, -1, 120, 75, 50)
    st_assert(st_zone_confirmable(fastShort, 12, 97, 50, false) and fastShort.trigger == 98, 'later touch-low break qualifies before distant swing')
    st_confirmation_anchor := 'Internal swing'

var result = table.new(position.middle_center, 1, 1)
if barstate.islast
    table.cell(result, 0, 0, 'PASS: 63 Smart Trade contract assertions', text_color=color.white, bgcolor=color.teal)
