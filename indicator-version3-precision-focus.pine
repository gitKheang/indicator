longs           =   input.int       (25     ,   "Long Length"                   ,   group= "TSI Slow Settings"                                  , display = display.none)
shorts          =   input.int       (13     ,   "Short Length"                  ,   group= "TSI Slow Settings"                                  , display = display.none)
signals         =   input.int       (13     ,   "Signal Length"                 ,   group= "TSI Slow Settings"                                  , display = display.none)

// ================================== //
// -----> Immutable Constants <------ //
// ================================== //    
 
sync            =   bar_index
labUp           =   label.style_label_up
labDn           =   label.style_label_down
confirmed       =   barstate.isconfirmed
extrap          =   extend ?        extend.right  : extend.none

var pivotHigh   =   array.new_box   (nPiv)
var pivotLows   =   array.new_box   (nPiv)  
var highBull    =   array.new_bool  (nPiv)
var lowsBull    =   array.new_bool  (nPiv)
var boxes       =   array.new_box   ()

haSrc           =   src    ==       "HA"    
hiLoSrc         =   src    ==       "High/Low"
tsifast         =   strat  ==       "Fast"
tsislow         =   strat  ==       "Slow"

// Automatic precision profile. Lower timeframes need stronger noise filtering;
// higher timeframes need fewer confirmation bars so signals remain timely.
float tfMinutes = timeframe.isseconds ? timeframe.multiplier / 60.0 : timeframe.isminutes ? timeframe.multiplier * 1.0 : timeframe.isdaily ? 1440.0 : timeframe.isweekly ? 10080.0 : 43200.0
int pivotLeft = auto_tf_tuning ? (tfMinutes <= 1 ? 14 : tfMinutes <= 5 ? 20 : tfMinutes <= 30 ? 14 : tfMinutes <= 240 ? 10 : 8) : left
int pivotRight = auto_tf_tuning ? (tfMinutes <= 1 ? 8 : tfMinutes <= 5 ? 12 : tfMinutes <= 30 ? 8 : tfMinutes <= 240 ? 6 : 4) : right
int reflectLen = auto_tf_tuning ? (tfMinutes <= 1 ? 12 : tfMinutes <= 5 ? 14 : tfMinutes <= 30 ? 12 : tfMinutes <= 240 ? 10 : 8) : reflect
int extremeOffset = auto_tf_tuning ? (tfMinutes <= 1 ? 0 : tfMinutes <= 240 ? 1 : 0) : offset
bool useSlowTsi = auto_tf_tuning ? tfMinutes <= 30 : tsislow
int validationHorizon = tfMinutes <= 5 ? 12 : tfMinutes <= 30 ? 8 : tfMinutes <= 240 ? 6 : 4

// ================================== //
// ---> Functional Declarations <---- //
// ================================== //


perMax          =   close*          0.02
min             =   math.min        (perMax, atr*0.3)

_haBody()       =>
    haClose     =   (open + high  +  low  + close)    / 4
    haOpen      =   float(na)
    haOpen      :=  na(haOpen[1]) ? (open + close)    / 2 : 
                   (nz(haOpen[1]) + nz(haClose[1]))   / 2
    
    [haOpen, haClose]
    
_extend(_x) =>
    for i = 0 to               array.size       (_x)-1
        box.set_right          (array.get       (_x, i), sync)
        
_arrayLoad(_x, _max, _val) =>  
    array.unshift                               (_x,   _val)   
    if  array.size                              (_x) > _max
        array.pop                               (_x)

_arrayBox(_x, _max, _val) =>  
    array.unshift                               (_x,   _val)   
    if       array.size                         (_x) > _max
        _b = array.pop                          (_x)
        if extend
            box.set_extend                      (_b, extend.none)

_arrayWrap(_x, _max, _val) =>  
    array.unshift                               (_x,   _val)   
    if  array.size                              (_x) > _max
        box.delete(array.pop                    (_x))

_delLab(_x)     =>
    if array.size(_x) > 0 
        label.delete           (array.pop       (_x))

_delLine(_x)    =>
    if array.size(_x) > 0 
        line.delete            (array.pop       (_x))

_delLevels(_x, _y)  =>
    for i = 0 to array.size                     (_x)-1
        _delLab                                 (_x)
        _delLine                                (_y)

_box(_x1, _t, _r, _b, _boCol, _bgCol, _e) =>
    box.new(                   _x1, _t, _r, _b  , 
     xloc        =             xloc.bar_index   ,
     extend      =             _e               ,
     border_color=             _boCol           ,   
     bgcolor     =             _bgCol           ) 

_wrap(_cond, _x, _bb, _bc, _bgc) =>
    _t           =             ta.highest       (high, _bb) + min
    _b           =             ta.lowest        (low , _bb) - min
    _l           =             bar_index -      _bb
    _r           =             bar_index +      1
    if  _cond
        _arrayWrap            (_x, max, _box    (_l, _t, _r, _b, _bc, _bgc, extend.none)) 

_getBox(_x,_i)   =>
    _box         =             array.get        (_x,_i)
    _t           =             box.get_top      (_box)
    _b           =             box.get_bottom   (_box)
    [_t, _b]
    
_align(_x,_y)    =>
    for i = 0 to               array.size       (_x) -1
        [_T, _B] =             _getBox          (_y, 0)
        [_t, _b] =             _getBox          (_x, i)
        if _T > _b and         _T < _t or 
           _B < _t and         _B > _b or 
           _T > _t and         _B < _b or 
           _B > _b and         _T < _t
            box.set_top        (array.get       (_y, 0), _t)
            box.set_bottom     (array.get       (_y, 0), _b)
 
_color(_x, _y)     =>
    var int _track = nPiv
    for i = 0 to               array.size       (_x) -1
        [t_, b_] =             _getBox          (_x, i)
        _isBull  =             array.get        (_y, i)
        if close > t_ and not  _isBull
            box.set_extend(    array.get        (_x, i), extend.none)
            array.set(_x, i,   _box             (sync  , t_, sync, b_, bullBorder, bullBgCol, extrap))
            array.set(_y, i,   true)
            _track += 1
        if close < b_ and _isBull
            box.set_extend(    array.get        (_x, i), extend.none)
            array.set(_x, i,   _box             (sync  , t_, sync, b_, bearBorder, bearBgCol, extrap))
            array.set(_y, i,   false)
            _track -= 1
    _track

_detect(_x,_y)      =>
    int  _i         = 0
    bool _found     = false
    bool _isBull    = na
    while (not _found and _i < array.size       (_x)  )
        [t_, b_] =             _getBox          (_x,_i)
        if low < t_ and high > b_
            _isBull :=         array.get        (_y,_i)
            _found  :=         true
        _i          +=         1
    [_found, _isBull]

_falseBreak(_l)     =>       
    bool _d         = false
    bool _u         = false
    for i = 1 to lookback
        if _l[i] < _l and _l[i+1] >= _l and _l[1] < _l 
            _d      := true
        if _l[i] > _l and _l[i+1] <= _l and _l[1] > _l 
            _u      := true
    [_d, _u]

_numLevel(_x,_y)    =>
    int _above      = 0
    int _fill       = 0
    for i = 0 to               array.size       (_x)-1
        _isBull     =          array.get        (_x,i)
        if  _isBull
            _above += 1
        if  not na(_isBull)
            _fill  += 1
    for i = 0 to               array.size       (_y)-1
        _isBull     =          array.get        (_y,i)
        if  _isBull
            _above += 1
        if  not na(_isBull)
            _fill  += 1
    [_above, _fill]  

_check(_src,_l)     =>
    bool _check     = false
    for i = 0 to _l
        if _src[i]
            _check := true
    _check

_count(_src, _l)    =>
    int _result     = 0
    for i = 0 to _l
        if _src > _src[i]
            _result += 1
    _result

_label(_x, _y, y, _s, _col1, _col2) =>
    transp = math.min   (color.t(_col1),  color.t(_col2))
    array.unshift       (_x,   label.new (sync+fut,   y                                        , 
                                          text      = str.tostring(math.round_to_mintick(y)   ), 
                                          color     = color.new(_col1, transp)                 , 
                                          style     = _s                                       , 
                                          textcolor = color.white                             ))
    if not extend and fut > 0
        array.unshift   (_y,   line.new  (sync, y, sync+fut, y, color= color.new(_col1, transp)))

_level(_x, _y)          =>
    var label [] lab    =      array.new_label  (nPiv)
    var line  [] lines  =      array.new_line   (nPiv)
    if barstate.islast and lLab
        _delLevels             (lab, lines)
        for i = 0 to           array.size       (_x)-1
            [_t, _b]    =      _getBox          (_x,i)
            _isBull     =      array.get        (_y,i)
            _col1        =     _isBull ?        bullBgCol  : bearBgCol
            _col2        =     _isBull ?        bullBorder : bearBorder
            if close >  _t 
                _label  (lab, lines, _t, labUp, _col1, _col2)
            if close <  _b 
                _label  (lab, lines, _b, labDn, _col1, _col2)
            if close <  _t and close >   _b
                _label  (lab, lines, _t, labDn, _col1, _col2)
                _label  (lab, lines, _b, labUp, _col1, _col2)

_alert(_x, _y) =>
    if _x
        alert   (_y + timeframe.period + ' chart. Price is ' + str.tostring(close), alertMode)
        
// ================================== //
// ----> Variable Calculations <----- //
// ================================== //

shortvar        =   useSlowTsi ?         shorts  :       shortf   
longvar         =   useSlowTsi ?         longs   :       longf    
signalvar       =   useSlowTsi ?         signals :       signalf 

tsi             =   ta.tsi              (close,         shortvar,   longvar)
tsl             =   ta.ema              (tsi,           signalvar)

highest         =   close ==            ta.highest      (close,     pivotRight)
lowest          =   close ==            ta.lowest       (close,     pivotRight)

closeLows       =   ta.lowest           (close,         swing)
closeHigh       =   ta.highest          (close,         swing)

numLows         =   _count              (low,           reflectLen)
numHigh         =   _count              (high,          reflectLen)

[open_, close_] =   _haBody             ()

hiHaBod         =   math.max            (close_,        open_)
loHaBod         =   math.min            (close_,        open_)

hiBod           =   math.max            (close,         open)
loBod           =   math.min            (close,         open)

srcHigh         =   haSrc ?             hiHaBod :       hiLoSrc ?   high :      hiBod
srcLow          =   haSrc ?             loHaBod :       hiLoSrc ?   low  :      loBod

pivot_high      =   ta.pivothigh        (srcHigh,       pivotLeft,  pivotRight)
pivot_low       =   ta.pivotlow         (srcLow,        pivotLeft,  pivotRight)

perc            =   close*              (per/100)

band            =   math.min            (atr*mult,      perc)       [pivotRight] /2

HH              =   pivot_high+         band
HL              =   pivot_high-         band

LH              =   pivot_low+          band
LL              =   pivot_low-          band

coDiff          =   close -             open

// ================================== //
// --------> Logical Order <--------- //
// ================================== //

if pivot_high and   dhighs and  confirmed
    _arrayLoad      (highBull , nPiv,   false)      
    _arrayBox       (pivotHigh, nPiv,   _box(sync[pivotRight], HH, sync, HL, bearBorder, bearBgCol, extrap))

if pivot_low  and   dlows and   confirmed
    _arrayLoad      (lowsBull , nPiv,   true)      
    _arrayBox       (pivotLows, nPiv,   _box(sync[pivotRight], LH, sync, LL, bullBorder, bullBgCol, extrap))

if alignZones
    _align          (pivotHigh,         pivotHigh)
    _align          (pivotHigh,         pivotLows)    
    _align          (pivotLows,         pivotLows)
    _align          (pivotLows,         pivotHigh)

_extend             (pivotHigh)
_extend             (pivotLows)

trackHigh       =   _color              (pivotHigh,     highBull)
trackLows       =   _color              (pivotLows,     lowsBull)

// ================================== //
// ----> Conditional Parameters <---- //
// ================================== //

isLows          =   closeLows      ==   close
isHigh          =   closeHigh      ==   close

wasLows         =   _check              (isLows,        lookback)
wasHigh         =   _check              (isHigh,        lookback)

[above, total]  =   _numLevel           (highBull,      lowsBull)

moveAbove       =   trackHigh       >   trackHigh[1]
moveBelow       =   trackLows       <   trackLows[1]

resBreak        =   (trackLows      >   trackLows[1]    or  moveAbove) 
supBreak        =   (trackHigh      <   trackHigh[1]    or  moveBelow) 

breakOut        =   moveAbove     and   highest and     above == total             
breakDwn        =   moveBelow     and   lowest  and     above == 0         

[dh, uh]        =   _falseBreak         (trackHigh) 
[dl, ul]        =   _falseBreak         (trackLows) 

falseBreakBull  =   wasLows       and   (dh or dl)
falseBreakBear  =   wasHigh       and   (uh or ul)

[fh,hb]         =   _detect             (pivotHigh,     highBull)
[fl,lb]         =   _detect             (pivotLows,     lowsBull)

bull            =   (fh or fl) and      (hb or lb)
bear            =   (fh or fl) and not  (hb or lb)

bullCheck       =   not resBreak  and   not resBreak[1] and (fh or fl) and  close > open and     (hb or lb)
bearCheck       =   not supBreak  and   not supBreak[1] and (fh or fl) and  close < open and not (hb or lb)

highrange       =   reflectLen-extremeOffset
lowsrange       =   extremeOffset

sigLows         =   numLows        <=   lowsrange  
sigHigh         =   numHigh        >=   highrange 

isBull1         =   sigLows       and   bull
isBear1         =   sigHigh       and   bear 

isBull2         =   (sigLows       or   sigLows[1]) and         (bull or bull[1])
isBear2         =   (sigHigh       or   sigHigh[1]) and         (bear or bear[1])

data            =   tsi > tsi[1]  and   tsi < tsl 
dtat            =   tsi < tsi[1]  and   tsi > tsl 

hMatch          =   not colorMatch or   close > open
sMatch          =   not colorMatch or   close < open

hsFilter        =   bj.barRange()  >=   hammerSize * atr
atrMaxSize      =   bj.barRange()  <=   atrMax     * atr or     atrMax == 0.0

rp              =   confirmed  or not   repaint

// ================================== //
// -----> Pattern Recognition <------ //
// ================================== //

dw              =   isBull1 and rp and d_  and atrMaxSize and bj.doji              (dojiSize           = dojiSize,         dojiWickSize    = dojiWickSize)
db              =   isBear1 and rp and d_  and atrMaxSize and bj.doji              (dojiSize           = dojiSize,         dojiWickSize    = dojiWickSize)
bew             =   isBull2 and rp and be_ and atrMaxSize and bj.bullEngulf        (maxRejectWick      = rejectWickMax,    mustEngulfWick  = ecWick) 
beb             =   isBear2 and rp and be_ and atrMaxSize and bj.bearEngulf        (maxRejectWick      = rejectWickMax,    mustEngulfWick  = ecWick)
h               =   isBull1 and rp and hs_ and atrMaxSize and bj.hammer            (ratio              = hammerFib,        shadowPercent   = hsShadowPerc) and hsFilter and hMatch
ss              =   isBear1 and rp and hs_ and atrMaxSize and bj.star              (ratio              = hammerFib,        shadowPercent   = hsShadowPerc) and hsFilter and sMatch
dd              =   isBull1 and rp and dg_ and atrMaxSize and bj.dragonflyDoji     ()
gd              =   isBear1 and rp and dg_ and atrMaxSize and bj.gravestoneDoji    ()
tb              =   isBull2 and rp and tw_ and atrMaxSize and bj.tweezerBottom     (closeUpperHalf     = closeHalf)
tt              =   isBear2 and rp and tw_ and atrMaxSize and bj.tweezerTop        (closeLowerHalf     = closeHalf)
stw             =   isBull1 and rp and st_ and atrMaxSize and bj.spinningTop       ()
stb             =   isBear1 and rp and st_ and atrMaxSize and bj.spinningTop       ()
p               =   isBull1 and rp and pc_ and atrMaxSize and bj.piercing          ()
dcc             =   isBear1 and rp and pc_ and atrMaxSize and bj.darkCloudCover    ()
bhw             =   isBull1 and rp and bh_ and atrMaxSize and bj.haramiBull        ()  
bhb             =   isBear1 and rp and bh_ and atrMaxSize and bj.haramiBear        ()
ll              =   isBull1 and rp and ls_ and atrMaxSize and bj.lls               (ratio              = luRatio)          and hsFilter
lu              =   isBear1 and rp and ls_ and atrMaxSize and bj.lus               (ratio              = luRatio)          and hsFilter

// ================================== //
// ------> Graphical Display <------- //
// ================================== //

plotFalseDn     =   confirmed and falseBull and falseBreakBull
plotFalseUp     =   confirmed and falseBear and falseBreakBear

falseUpCol      =   plotFalseUp     ?   upCol       :   na
falseDnCol      =   plotFalseDn     ?   dnCol       :   na

plotBreakOut    =   confirmed and breakOut and detectBO and not plotFalseDn
plotBreakDn     =   confirmed and breakDwn and detectBD and not plotFalseUp

plotResBreak    =   confirmed and resBreak and breakUp and not (plotBreakOut or plotFalseDn)
plotSupBreak    =   confirmed and supBreak and breakDn and not (plotBreakDn or plotFalseUp)

// Precision profile: require a significant local extreme and a decisive
// rejection candle. Weak touches and tiny-body candles are not signals.
precisionRange = math.max(high - low, syminfo.mintick)
precisionBody = math.abs(close - open)
bullCandleQuality = close > open and (close - low) / precisionRange >= 0.62 and precisionBody >= atr * 0.12
bearCandleQuality = close < open and (high - close) / precisionRange >= 0.62 and precisionBody >= atr * 0.12
bullReactionQualified = bullCheck and sigLows and (tfMinutes > 1 or bullCandleQuality)
bearReactionQualified = bearCheck and sigHigh and (tfMinutes > 1 or bearCandleQuality)
bullCurlQualified = curl and data and bull and sigLows and (tfMinutes > 1 or bullCandleQuality)
bearCurlQualified = curl and dtat and bear and sigHigh and (tfMinutes > 1 or bearCandleQuality)

plotBullCheck   = confirmed and supPush and bullReactionQualified and not bullReactionQualified[1]
plotBearCheck   = confirmed and resPush and bearReactionQualified and not bearReactionQualified[1]
plotCurlBull    = confirmed and bullCurlQualified and not bullCurlQualified[1]
plotCurlBear    = confirmed and bearCurlQualified and not bearCurlQualified[1]

// Conservative historical validation: after each unique marker, require a
// 0.75 ATR favorable move within the timeframe-adjusted horizon without a
// 0.75 ATR adverse excursion. Same-bar target and risk counts as invalid.
buyValidationEvent = plotBullCheck or plotCurlBull
sellValidationEvent = plotBearCheck or plotCurlBear
buyEvaluation = buyValidationEvent[validationHorizon]
sellEvaluation = sellValidationEvent[validationHorizon]
buyTargetHit = ta.highest(high, validationHorizon) >= close[validationHorizon] + atr[validationHorizon] * validation_target_atr
buyRiskHit = ta.lowest(low, validationHorizon) <= close[validationHorizon] - atr[validationHorizon] * validation_risk_atr
sellTargetHit = ta.lowest(low, validationHorizon) <= close[validationHorizon] - atr[validationHorizon] * validation_target_atr
sellRiskHit = ta.highest(high, validationHorizon) >= close[validationHorizon] + atr[validationHorizon] * validation_risk_atr

var int validationTotal = 0
var int validationValid = 0
if barstate.isconfirmed
    if buyEvaluation
        validationTotal += 1
        if buyTargetHit and not buyRiskHit
            validationValid += 1
    if sellEvaluation
        validationTotal += 1
        if sellTargetHit and not sellRiskHit
            validationValid += 1

validationRate = validationTotal > 0 ? validationValid * 100.0 / validationTotal : na
var table validationTable = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast and show_signal_validation
    table.cell(validationTable, 0, 0, "Validation FT", bgcolor=dashboard_header_css, text_color=dashboard_text_css)
    table.cell(validationTable, 1, 0, timeframe.period, bgcolor=dashboard_header_css, text_color=dashboard_text_css)
    table.cell(validationTable, 0, 1, "Samples", bgcolor=color.new(theme_neutral_dark_css, 35), text_color=theme_text_css)
    table.cell(validationTable, 1, 1, str.tostring(validationTotal), bgcolor=color.new(theme_neutral_dark_css, 35), text_color=theme_text_css)
    table.cell(validationTable, 0, 2, "Valid", bgcolor=color.new(theme_neutral_dark_css, 35), text_color=theme_text_css)
    table.cell(validationTable, 1, 2, str.tostring(validationValid), bgcolor=color.new(theme_neutral_dark_css, 35), text_color=theme_text_css)
    table.cell(validationTable, 0, 3, "Rate", bgcolor=color.new(theme_neutral_dark_css, 35), text_color=theme_text_css)
    table.cell(validationTable, 1, 3, na(validationRate) ? "n/a" : str.tostring(validationRate, "#.0") + "%", bgcolor=color.new(theme_neutral_dark_css, 35), text_color=theme_text_css)
if barstate.islast and not show_signal_validation
    table.clear(validationTable, 0, 0, 1, 3)

// Normal-sized text-glyph markers remain readable while the ATR lanes keep
// independent same-bar signals vertically separated.
signal_marker_atr = ta.atr(14)
signal_arrow_size = size.normal
signal_triangle_size = size.normal

draw_signal_marker(_is_up, _lane, _marker_color, _triangle, _marker_size, _tooltip) =>
    _base_gap = math.max(signal_marker_atr * marker_base_atr, syminfo.mintick * 10)
    _lane_gap = math.max(signal_marker_atr * marker_lane_atr, syminfo.mintick * 10)
    _marker_y = _is_up ? low - _base_gap - _lane_gap * (_lane - 1) : high + _base_gap + _lane_gap * (_lane - 1)
    _marker_text = _triangle ? (_is_up ? '▲' : '▼') : (_is_up ? '↑' : '↓')
    label.new(bar_index, _marker_y, _marker_text
      , xloc = xloc.bar_index
      , yloc = yloc.price
      , color = TRANSP_CSS
      , textcolor = _marker_color
      , style = label.style_none
      , size = _marker_size
      , tooltip = show_marker_tooltips ? _tooltip : '')

int below_signal_lane = 0
int above_signal_lane = 0

if plotFalseUp
    _false_up_direction = coDiff > 0
    if _false_up_direction
        below_signal_lane += 1
        draw_signal_marker(true, below_signal_lane, falseBreakupCol, false, signal_arrow_size, 'False Breakup / Bull Trap')
    else
        above_signal_lane += 1
        draw_signal_marker(false, above_signal_lane, falseBreakupCol, false, signal_arrow_size, 'False Breakup / Bull Trap')

if plotFalseDn
    _false_dn_direction = coDiff > 0
    if _false_dn_direction
        below_signal_lane += 1
        draw_signal_marker(true, below_signal_lane, falseBreakdownCol, false, signal_arrow_size, 'False Breakdown / Bear Trap')
    else
        above_signal_lane += 1
        draw_signal_marker(false, above_signal_lane, falseBreakdownCol, false, signal_arrow_size, 'False Breakdown / Bear Trap')

if plotBreakOut
    below_signal_lane += 1
    draw_signal_marker(true, below_signal_lane, upCol, false, signal_arrow_size, 'Breakout')

if plotBreakDn
    above_signal_lane += 1
    draw_signal_marker(false, above_signal_lane, dnCol, false, signal_arrow_size, 'Breakdown')

if plotResBreak
    below_signal_lane += 1
    draw_signal_marker(true, below_signal_lane, supCol, false, signal_arrow_size, 'Resistance Break')

if plotSupBreak
    above_signal_lane += 1
    draw_signal_marker(false, above_signal_lane, resCol, false, signal_arrow_size, 'Support Break')

if plotBullCheck
    below_signal_lane += 1
    draw_signal_marker(true, below_signal_lane, moveBullCol, true, signal_triangle_size, 'Bullish Support Reaction')

if plotBearCheck
    above_signal_lane += 1
    draw_signal_marker(false, above_signal_lane, moveBearCol, true, signal_triangle_size, 'Bearish Resistance Reaction')

if plotCurlBull
    below_signal_lane += 1
    draw_signal_marker(true, below_signal_lane, curlBullCol, true, signal_triangle_size, 'Bullish TSI Curl')

if plotCurlBear
    above_signal_lane += 1
    draw_signal_marker(false, above_signal_lane, curlBearCol, true, signal_triangle_size, 'Bearish TSI Curl')

bj.dLab             (dw  and labels, labNeutCol, textNeutCol), _wrap (dw  and sBox, boxes, 1, patNeutBo, patNeutBg)
bj.bewLab           (bew and labels, labBullCol, textBullCol), _wrap (bew and sBox, boxes, 2, patBullBo, patBullBg)
bj.hLab             (h   and labels, labBullCol, textBullCol), _wrap (h   and sBox, boxes, 1, patBullBo, patBullBg)
bj.ddLab            (dd  and labels, labBullCol, textBullCol), _wrap (dd  and sBox, boxes, 1, patBullBo, patBullBg)
bj.tbLab            (tb  and labels, labBullCol, textBullCol), _wrap (tb  and sBox, boxes, 2, patBullBo, patBullBg)
bj.stwLab           (stw and labels, labNeutCol, textNeutCol), _wrap (stw and sBox, boxes, 1, patBullBo, patNeutBg)
bj.pLab             (p   and labels, labBullCol, textBullCol), _wrap (p   and sBox, boxes, 2, patBullBo, patBullBg)
bj.hwLab            (bhw and labels, labBullCol, textBullCol), _wrap (bhw and sBox, boxes, 2, patBullBo, patBullBg)
bj.llsLab           (ll  and labels, labBullCol, textBullCol), _wrap (ll  and sBox, boxes, 1, patBullBo, patBullBg)

bj.dLab             (db  and labels, labNeutCol, textNeutCol), _wrap (db  and sBox, boxes, 1, patNeutBo, patNeutBg)
bj.bebLab           (beb and labels, labBearCol, textBearCol), _wrap (beb and sBox, boxes, 2, patBearBo, patBearBg)
bj.ssLab            (ss  and labels, labBearCol, textBearCol), _wrap (ss  and sBox, boxes, 1, patBearBo, patBearBg)
bj.gdLab            (gd  and labels, labBearCol, textBearCol), _wrap (gd  and sBox, boxes, 1, patBearBo, patBearBg)
bj.ttLab            (tt  and labels, labBearCol, textBearCol), _wrap (tt  and sBox, boxes, 2, patBearBo, patBearBg)
bj.stbLab           (stb and labels, labNeutCol, textNeutCol), _wrap (stb and sBox, boxes, 1, patBearBo, patBearBg)
bj.dccLab           (dcc and labels, labBearCol, textBearCol), _wrap (dcc and sBox, boxes, 2, patBearBo, patBearBg)
bj.hbLab            (bhb and labels, labBearCol, textBearCol), _wrap (bhb and sBox, boxes, 2, patBearBo, patBearBg)
bj.lusLab           (lu  and labels, labBearCol, textBearCol), _wrap (lu  and sBox, boxes, 1, patBearBo, patBearBg)

_level              (pivotHigh, highBull)
_level              (pivotLows, lowsBull)

// ================================== //
// -----> Alert Functionality <------ //
// ================================== //

alertcondition      (resBreak       ,   'Resistance break'                      ,   'Resistance broke on {{interval}} chart. Price is {{close}}'                    )
alertcondition      (supBreak       ,   'Support break'                         ,   'Support broke on {{interval}} chart. Price is {{close}}'                       )
alertcondition      (bullCheck      ,   'Found support'                         ,   'Pushing Off Key Level Support on {{interval}} chart. Price is {{close}}'       )
alertcondition      (bearCheck      ,   'Found resistance'                      ,   'Pushing Off Key Level Resistance on {{interval}} chart. Price is {{close}}'    )
alertcondition      (falseBreakBull ,   'False break down'                      ,   'False Break Down on {{interval}} chart. Price is {{close}}'                    )
alertcondition      (falseBreakBear ,   'False break up'                        ,   'False Break Up on {{interval}} chart. Price is {{close}}'                      )
alertcondition      (breakOut       ,   'Breakout'                              ,   'Breakout on {{interval}} chart. Price is {{close}}'                            )
alertcondition      (breakDwn       ,   'Breakdown'                             ,   'Breakdown on {{interval}} chart. Price is {{close}}'                           )

_alert              (plotResBreak   ,   'Resistance broke on '                  )
_alert              (plotSupBreak   ,   'Support break '                        )
_alert              (plotBullCheck  ,   'Pushing off key level support on '     )
_alert              (plotBearCheck  ,   'Pushing off key level resistance on '  )
_alert              (plotFalseDn    ,   'False break down on '                  )
_alert              (plotFalseUp    ,   'False break up on '                    )
_alert              (plotBreakOut   ,   'Breakout on '                          )
_alert              (plotBreakDn    ,   'Breakdown on '                         )

_alert              (dw             ,   'Doji at support on '                   )
_alert              (db             ,   'Doji at resistance on '                )
_alert              (bew            ,   'Bullish Engulfing on '                 )
_alert              (beb            ,   'Bearish Engulfing on '                 )
_alert              (h              ,   'Hammer candle on '                     )
_alert              (ss             ,   'Shooting star on '                     )
_alert              (dd             ,   'Dragonfly Doji on '                    )
_alert              (gd             ,   'Gravestone Doji on '                   )
_alert              (tb             ,   'Tweezer Bottom on '                    )
_alert              (tt             ,   'Tweezer Top on '                       )
_alert              (stw            ,   'White Spinning Top on '                )
_alert              (stb            ,   'Black Spinning Top on '                )
_alert              (p              ,   'Piercing on '                          )
_alert              (dcc            ,   'Dark Cloud Cover on '                  )
_alert              (bhw            ,   'Bullish Harami on '                    )
_alert              (bhb            ,   'Bearish Harami on '                    )
_alert              (ll             ,   'Long Lower Shadow on '                 )
_alert              (lu             ,   'Long Upper Shadow on '                 )
//
//Directions
directions = input.bool(true, title="If you change the Place On The List number, you can reorder the indicators to suit your preferences. Make sure that you change the position number for BOTH indicators for it to show up properly. For example: If you change MACD to position 3, make sure to change whatever indicator is in position 3 to the number that the MACD was before so they switch places(do this even if one of them is turned off). You can also turn off each individual indicator so it only shows the ones you want.", display = display.none)

//Table On/Off
infoDataTableOn = input.bool(true, title="الاتجاه On/Off", group="Info الاتجاه", display = display.none)

//Table Positions
bright = position.bottom_right
bleft = position.bottom_left
bcenter = position.bottom_center
tright = position.top_right
tleft = position.top_left
tcenter = position.top_center
mright = position.middle_right
mleft = position.middle_left
mcenter = position.middle_center
itablePosition = input.string(bright, title="1", options=[bright, bleft, bcenter, tright, tleft, tcenter, mright, mleft, mcenter], group="Info الاتجاه", display = display.none)

//Lengths
macdOn = input.bool(true, title="Turn MACD Label On/Off", group="MACD Settings", display = display.none)
macdOrder = input.int(1, title="Place On The List", minval=1, maxval=9, group="MACD Settings", display = display.none)
macdFast = input.int(12, title="MACD Fast Length", minval=2, group="MACD Settings", display = display.none)
macdSlow = input.int(26, title="MACD Slow Length", minval=2, group="MACD Settings", display = display.none)
macdSignal = input.int(9, title="MACD Signal Length", minval=2, group="MACD Settings", display = display.none)
stochasticOn = input.bool(true, title="Turn Stochstic RSI Label On/Off", group="Stochastic RSI Settings", display = display.none)
stochasticOrder = input.int(2, title="Place On The List", minval=1, maxval=9, group="Stochastic RSI Settings", display = display.none)
smoothK = input.int(3, "K Value - Stochastic RSI", minval=2, group="Stochastic RSI Settings", display = display.none)
smoothD = input.int(3, "D Value - Stochastic RSI", minval=2, group="Stochastic RSI Settings", display = display.none)
lengthRSI = input.int(14, "Stochastic RSI Length", minval=2, group="Stochastic RSI Settings", display = display.none)
lengthStoch = input.int(14, "Stochastic Length", minval=2, group="Stochastic RSI Settings", display = display.none)
vortexOn = input.bool(true, title="Turn Vortex Label On/Off", group="Vortex Settings", display = display.none)
vortexOrder = input.int(3, title="Place On The List", minval=1, maxval=9, group="Vortex Settings", display = display.none)
vortexLength = input.int(14, title="Vortex Length", minval=2, group="Vortex Settings", display = display.none)
momOn = input.bool(true, title="Turn Momentum Label On/Off", group="Momentum Settings", display = display.none)
momOrder = input.int(4, title="Place On The List", minval=1, maxval=9, group="Momentum Settings", display = display.none)
momLength = input.int(14, title="Momentum Length", minval=2, group="Momentum Settings", display = display.none)
rsiOn = input.bool(true, title="Turn RSI Label On/Off", group="RSI Settings", display = display.none)
rsiOrder = input.int(5, title="Place On The List", minval=1, maxval=9, group="RSI Settings", display = display.none)
rsiLength = input.int(14, title="Relative Strength Index Length", minval=2, group="RSI Settings", display = display.none)
psarOn = input.bool(true, title="Turn PSAR Label On/Off", group="PSAR Settings", display = display.none)
psarOrder = input.int(6, title="Place On The List", minval=1, maxval=9, group="PSAR Settings", display = display.none)
psarStart = input.float(.02, title="PSAR Start", minval=.01, group="PSAR Settings", display = display.none)
psarInc = input.float(.02, title="PSAR Increment", minval=.01, group="PSAR Settings", display = display.none)
psarMax = input.float(.2, title="PSAR Max", minval=.01, group="PSAR Settings", display = display.none)
dmiOn = input.bool(true, title="Turn DMI Label On/Off", group="DMI Settings", display = display.none)
dmiOrder = input.int(7, title="Place On The List", minval=1, maxval=9, group="DMI Settings", display = display.none)
dmiLength = input.int(14, title="DMI Length", minval=2, group="DMI Settings", display = display.none)
dmiSmooth = input.int(14, title="DMI Smoothing", minval=2, group="DMI Settings", display = display.none)
mfiOn = input.bool(true, title="Turn Money Flow Index Label On/Off", group="Money Flow Index Settings", display = display.none)
mfiOrder = input.int(8, title="Place On The List", minval=1, maxval=9, group="Money Flow Index Settings", display = display.none)
mfiLength = input.int(14, title="Money Flow Index Length", minval=2, group="Money Flow Index Settings", display = display.none)
fisherOn = input.bool(true, title="Turn Fisher Label On/Off", group="Fisher Settings", display = display.none)
fisherOrder = input.int(9, title="Place On The List", minval=1, maxval=9, group="Fisher Settings", display = display.none)
fisherLength = input.int(14, title="Fisher Length", minval=2, group="Fisher Settings", display = display.none)

//Fisher Transform
high_ = ta.highest(hl2, fisherLength)
low_ = ta.lowest(hl2, fisherLength)
round_(val) => val > .99 ? .999 : val < -.99 ? -.999 : val
value = 0.0
value := round_(.66 * ((hl2 - low_) / (high_ - low_) - .5) + .67 * nz(value[1]))
fish1 = 0.0
fish1 := .5 * math.log((1 + value) / (1 - value)) + .5 * nz(fish1[1])
fish2 = fish1[1]

//Stochastic RSI
rsi1 = ta.rsi(close, lengthRSI)
k = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK)
d = ta.sma(k, smoothD)

//Vortex
VMP = math.sum( math.abs( high - low[1]), vortexLength)
VMM = math.sum( math.abs( low - high[1]), vortexLength)
STR = math.sum( ta.atr(1), vortexLength)
VIP = VMP / STR
VIM = VMM / STR

//DMI
[diplus, diminus, adx] = ta.dmi(dmiLength, dmiSmooth)

//PSAR
psar = ta.sar(psarStart, psarInc, psarMax)

//Momentum
mom = ta.mom(close, momLength)

//Money Flow Index
mfi = ta.mfi(close, mfiLength)

//RSI
rsi = ta.rsi(close, rsiLength)

//MACD
[macdLine, signalLine, histLine] = ta.macd(close, macdFast, macdSlow, macdSignal)

//Create MACD indicator label table data
macdIndicatorLabel = '  MACD    wait '
macdLabel = dashboard_wait_css
if macdLine > signalLine
    macdLabel := dashboard_bull_css
    macdIndicatorLabel := " MACD    buy "
else if macdLine < signalLine
    macdLabel := dashboard_bear_css
    macdIndicatorLabel := " MACD     sell "
    
//Create Stochastic RSI indicator label table data
stochIndicatorLabel = 'Stoch    wait '
stochLabel = dashboard_wait_css
if k > d
    stochLabel := dashboard_bull_css
    stochIndicatorLabel := " Stoch    buy "
else if k < d
    stochLabel := dashboard_bear_css
    stochIndicatorLabel := " Stoch      sell "
    
//Create Vortex indicator label table data
vortexIndicatorLabel = '  Vortex   wait '
vortexLabel = dashboard_wait_css
if VIP > VIM
    vortexLabel := dashboard_bull_css
    vortexIndicatorLabel := " Vortex    buy "
else if VIP < VIM
    vortexLabel := dashboard_bear_css
    vortexIndicatorLabel := " Vortex    sell "

//Create MFI indicator label table data
mfiIndicatorLabel = 'MFI        wait '
mfiLabel = dashboard_wait_css
if mfi > mfi[1]
    mfiLabel := dashboard_bull_css
    mfiIndicatorLabel := " MFI        buy "
else if mfi < mfi[1]
    mfiLabel := dashboard_bear_css
    mfiIndicatorLabel := " MFI        sell "
    
//Create Fisher indicator label table data
fisherIndicatorLabel = '  Fisher   wait '
fisherLabel = dashboard_wait_css
if fish1 > fish2
    fisherLabel := dashboard_bull_css
    fisherIndicatorLabel := " Fisher    buy "
else if fish1 < fish2
    fisherLabel := dashboard_bear_css
    fisherIndicatorLabel := " Fisher     sell "
    
//Create DMI indicator label table data
dmiIndicatorLabel = '  DMI       wait '
dmiLabel = dashboard_wait_css
if diplus > diminus
    dmiLabel := dashboard_bull_css
    dmiIndicatorLabel := " DMI        buy "
else if diplus < diminus
    dmiLabel := dashboard_bear_css
    dmiIndicatorLabel := " DMI        sell "
    
//Create Momentum indicator label table data
momIndicatorLabel = '  Mom      wait '
momLabel = dashboard_wait_css
if mom > mom[1]
    momLabel := dashboard_bull_css
    momIndicatorLabel := " Mom      buy "
else if mom < mom[1]
    momLabel := dashboard_bear_css
    momIndicatorLabel := " Mom       sell "
    
//Create PSAR indicator label table data
psarIndicatorLabel = '  PSAR     wait '
psarLabel = dashboard_wait_css
if close > psar
    psarLabel := dashboard_bull_css
    psarIndicatorLabel := " PSAR     buy "
else if close < psar
    psarLabel := dashboard_bear_css
    psarIndicatorLabel := " PSAR      sell "

//Create RSI indicator label table data
rsiIndicatorLabel = '  RSI        wait '
rsiLabel = dashboard_wait_css
if rsi > rsi[1]
    rsiLabel := dashboard_bull_css
    rsiIndicatorLabel := " RSI        buy "
else if rsi < rsi[1]
    rsiLabel := dashboard_bear_css
    rsiIndicatorLabel := " RSI         sell "

//Plot Price Difference Table
infoDataTable = table.new(itablePosition, columns=1, rows=10)
if infoDataTableOn and barstate.islast
    table.cell(table_id=infoDataTable, column=0, row=mfiOrder, text=mfiOn ? mfiIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=mfiLabel)
    table.cell(table_id=infoDataTable, column=0, row=fisherOrder, text=fisherOn ? fisherIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=fisherLabel)
    table.cell(table_id=infoDataTable, column=0, row=dmiOrder, text=dmiOn ? dmiIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=dmiLabel)
    table.cell(table_id=infoDataTable, column=0, row=momOrder, text=momOn ? momIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=momLabel)
    table.cell(table_id=infoDataTable, column=0, row=psarOrder, text=psarOn ? psarIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=psarLabel)
    table.cell(table_id=infoDataTable, column=0, row=rsiOrder, text=rsiOn ? rsiIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=rsiLabel)
    table.cell(table_id=infoDataTable, column=0, row=macdOrder, text=macdOn ? macdIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=macdLabel)
    table.cell(table_id=infoDataTable, column=0, row=stochasticOrder, text=stochasticOn ? stochIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=stochLabel)
    table.cell(table_id=infoDataTable, column=0, row=vortexOrder, text=vortexOn ? vortexIndicatorLabel : na, height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=vortexLabel)
    table.cell(table_id=infoDataTable, column=0, row=0, text=" direction", height=0, text_color=dashboard_text_css, text_halign=text.align_left, text_valign=text.align_top, bgcolor=dashboard_header_css)

//Alerts
alertcondition(rsiLabel == dashboard_bear_css and mfiLabel == dashboard_bear_css and fisherLabel == dashboard_bear_css and dmiLabel == dashboard_bear_css and momLabel == dashboard_bear_css and psarLabel == dashboard_bear_css and 
 macdLabel == dashboard_bear_css and stochLabel == dashboard_bear_css and vortexLabel == dashboard_bear_css, "All Bearish Indicators Alert", "All Bearish Indicators {{ticker}} {{interval}}")
 
alertcondition(rsiLabel == dashboard_bull_css and mfiLabel == dashboard_bull_css and fisherLabel == dashboard_bull_css and dmiLabel == dashboard_bull_css and momLabel == dashboard_bull_css and psarLabel == dashboard_bull_css and 
 macdLabel == dashboard_bull_css and stochLabel == dashboard_bull_css and vortexLabel == dashboard_bull_css, "All Bullish Indicators Alert", "All Bullish Indicators {{ticker}} {{interval}}")
 //
//////////////////////////////////////////////////////////////////////////////////////////


// BULB Indicator settings
recommendation = input(true, title='BULB', display = display.none)
rsiSource = close
rsiLength1 = 13
rsiOverbought = 65
rsiOvesold = 30
rsiValue = ta.rsi(rsiSource, rsiLength1)
isOverbought = rsiValue >= rsiOverbought
isOversold = rsiValue <= rsiOvesold
var laststate = 0
var hh = low
var ll1 = high
var label labelll = na
var label labelhh = na
var last_actual_label_hh_price = 0.0
var last_actual_label_ll_price = 0.0

obLabelText() =>
    if last_actual_label_hh_price < high
        'sell'
    else
        'sell'

osLabelText() =>
    if last_actual_label_ll_price < low
        'buy'
    else
        'buy'

createOverBoughtLabel(isIt) =>
    if isIt
        label.new(x=bar_index, y=na, yloc=yloc.price, style=label.style_label_down, color=theme_bear_border_css, size=size.normal, text=obLabelText(), textcolor=dashboard_text_css)
    else
        label.new(x=bar_index, y=na, yloc=yloc.price, style=label.style_label_up, color=theme_bull_border_css, size=size.normal, text=osLabelText(), textcolor=dashboard_text_css)

moveOversoldLabel() =>
    label.set_x(labelll, bar_index)
    label.set_y(labelll, low)
    label.set_text(labelll, osLabelText())

moveOverBoughtLabel() =>
    label.set_x(labelhh, bar_index)
    label.set_y(labelhh, high)
    label.set_text(labelhh, obLabelText())

if laststate == 2 and isOverbought and recommendation
    hh := high
    labelhh := createOverBoughtLabel(true)
    last_actual_label_ll_price := label.get_y(labelll)
    labelll_ts = label.get_x(labelll)
    labelll_price = label.get_y(labelll)
    labelll_price

if laststate == 1 and isOversold and recommendation
    ll1 := low
    labelll := createOverBoughtLabel(false)
    last_actual_label_hh_price := label.get_y(labelhh)
    labelhh_ts = label.get_x(labelhh)
    labelhh_price = label.get_y(labelhh)
    labelhh_price

if isOverbought and recommendation
    if high >= hh
        hh := high
        moveOverBoughtLabel()
    laststate := 1
    laststate

if isOversold and recommendation
    if low <= ll1
        ll1 := low
        moveOversoldLabel()
    laststate := 2
    laststate

if laststate == 1 and isOverbought and recommendation
    if hh <= high
        hh := high
        moveOverBoughtLabel()

if laststate == 2 and isOversold and recommendation
    if low <= ll1
        ll1 := low
        moveOversoldLabel()

if laststate == 1 and recommendation
    if hh <= high
        hh := high
        moveOverBoughtLabel()

if laststate == 2 and recommendation
    if ll1 >= low
        ll1 := low
        moveOversoldLabel()

// Custom ATR Bands settings
mal = input(defval=47, title='Half Length', display = display.none)
mva = ta.sma(close, mal)
atrl = input(defval=89, title='Atr Length', display = display.none)
atrv = ta.atr(atrl)
atrm = input(defval=3.0, title='Atr Multiplier', display = display.none)
pEnv = mva + mva * atrv / close * atrm
mEnv = mva - mva * atrv / close * atrm

plot(mva, title='Simple Moving Average', linewidth=2)
plot(pEnv, color=theme_bear_border_css, title='High Envelope', linewidth=2)
plot(mEnv, color=theme_bull_border_css, title='Low Envelope', linewidth=2)

//=============================================================================
// Precision Focus v3
// Additive high-confidence layer. Existing SMC/ICT, Demand/Supply, Pivot S/R,
// FVG, dashboard, BULB, ATR bands, arrows, triangles, and alerts stay intact.
//=============================================================================

PF_GROUP = 'Precision Focus v3'
PF_VIS_GROUP = 'Precision Focus v3 - Display'
PF_TEST_GROUP = 'Precision Focus v3 - Validation'

pf_enabled = input.bool(true, 'Enable Precision Focus', group=PF_GROUP)
pf_require_1m = input.bool(true, 'Require 1-minute chart', group=PF_GROUP,
  tooltip='The default calibration uses 1-minute entries with confirmed 15-minute and 1-hour context.')
pf_fast_tf = input.timeframe('15', 'Fast context timeframe', group=PF_GROUP)
pf_slow_tf = input.timeframe('60', 'Slow context timeframe', group=PF_GROUP)
pf_htf_pivot_length = input.int(3, 'HTF structure pivot length', minval=2, maxval=10, group=PF_GROUP)
pf_score_threshold = input.int(72, 'A+ score threshold', minval=50, maxval=95, group=PF_GROUP,
  tooltip='Engineering threshold only. It is not a probability or promised win rate.')
pf_confirm_window = input.int(5, 'Confirmation window (bars)', minval=1, maxval=12, group=PF_GROUP)
pf_liquidity_lookback = input.int(10, 'Liquidity lookback', minval=3, maxval=50, group=PF_GROUP)
pf_signal_atr_length = input.int(20, 'Signal ATR length', minval=5, maxval=100, group=PF_GROUP)
pf_displacement_atr = input.float(0.30, 'Minimum displacement body (ATR)', minval=0.10, maxval=1.50, step=0.05, group=PF_GROUP)
pf_max_distance_atr = input.float(3.0, 'Maximum AOI distance (ATR)', minval=0.5, maxval=10.0, step=0.5, group=PF_GROUP)
pf_max_touches = input.int(1, 'Maximum AOI touches', minval=1, maxval=3, group=PF_GROUP)
pf_zone_expiry = input.int(1500, 'AOI expiry (bars)', minval=100, maxval=10000, group=PF_GROUP)
pf_registry_limit = input.int(80, 'Maximum stored AOIs', minval=20, maxval=200, group=PF_GROUP)

pf_show_setups = input.bool(true, 'Show SETUP markers', group=PF_VIS_GROUP)
pf_show_focus = input.bool(true, 'Show A+ BUY/SELL markers', group=PF_VIS_GROUP)
pf_show_table = input.bool(true, 'Show Precision Focus table', group=PF_VIS_GROUP)
pf_table_position = input.string(position.middle_right, 'Precision Focus table position', options=[position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_center, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group=PF_VIS_GROUP)

pf_validation_enabled = input.bool(true, 'Track Focus outcomes', group=PF_TEST_GROUP)
pf_validation_horizon = input.int(30, 'Outcome horizon (bars)', minval=5, maxval=200, group=PF_TEST_GROUP)
pf_validation_buffer_atr = input.float(0.10, 'Invalidation buffer (ATR)', minval=0.0, maxval=1.0, step=0.05, group=PF_TEST_GROUP)

pf_signal_atr = ta.atr(pf_signal_atr_length)
pf_chart_supported = not pf_require_1m or (timeframe.isminutes and timeframe.multiplier == 1)
pf_active = pf_enabled and pf_chart_supported

// Confirmed HTF structural bias. The [1] historical offset in each request is
// paired with lookahead_on, so Focus never reads an unfinished HTF result.
pf_structure_bias() =>
    _pivot_high = ta.pivothigh(high, pf_htf_pivot_length, pf_htf_pivot_length)
    _pivot_low = ta.pivotlow(low, pf_htf_pivot_length, pf_htf_pivot_length)
    var float _last_high = na
    var float _last_low = na
    var int _bias = 0
    if not na(_pivot_high)
        _last_high := _pivot_high
    if not na(_pivot_low)
        _last_low := _pivot_low
    if not na(_last_high) and close > _last_high
        _bias := 1
    else if not na(_last_low) and close < _last_low
        _bias := -1
    _bias

pf_fast_bias = request.security(syminfo.tickerid, pf_fast_tf, pf_structure_bias()[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
pf_slow_bias = request.security(syminfo.tickerid, pf_slow_tf, pf_structure_bias()[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// One bounded immutable registry shared by SMC OB, Demand/Supply, Pivot S/R,
// and FVG logical views. Bounds/source never change after registration.
var pf_ids = array.new_string(0)
var pf_dirs = array.new_int(0)
var pf_tops = array.new_float(0)
var pf_bottoms = array.new_float(0)
var pf_sources = array.new_string(0)
var pf_qualities = array.new_int(0)
var pf_created_bars = array.new_int(0)
var pf_touches = array.new_int(0)
var pf_active_zones = array.new_bool(0)
var pf_inside_zones = array.new_bool(0)
var pf_consumed = array.new_bool(0)
var pf_last_touch_bars = array.new_int(0)

pf_shift_registry() =>
    array.shift(pf_ids)
    array.shift(pf_dirs)
    array.shift(pf_tops)
    array.shift(pf_bottoms)
    array.shift(pf_sources)
    array.shift(pf_qualities)
    array.shift(pf_created_bars)
    array.shift(pf_touches)
    array.shift(pf_active_zones)
    array.shift(pf_inside_zones)
    array.shift(pf_consumed)
    array.shift(pf_last_touch_bars)

pf_register_zone(_id, _dir, _top, _bottom, _source, _quality) =>
    _valid = _id != '' and (_dir == 1 or _dir == -1) and not na(_top) and not na(_bottom) and _top > _bottom
    if _valid and not array.includes(pf_ids, _id)
        array.push(pf_ids, _id)
        array.push(pf_dirs, _dir)
        array.push(pf_tops, _top)
        array.push(pf_bottoms, _bottom)
        array.push(pf_sources, _source)
        array.push(pf_qualities, _quality)
        array.push(pf_created_bars, bar_index)
        array.push(pf_touches, 0)
        array.push(pf_active_zones, true)
        array.push(pf_inside_zones, false)
        array.push(pf_consumed, false)
        array.push(pf_last_touch_bars, int(na))
        if array.size(pf_ids) > pf_registry_limit
            pf_shift_registry()

pf_id_index(_id) =>
    _id == '' ? -1 : array.indexof(pf_ids, _id)

pf_id_eligible(_id) =>
    _index = pf_id_index(_id)
    bool _eligible = false
    if _index >= 0
        _eligible := array.get(pf_active_zones, _index) and not array.get(pf_consumed, _index) and array.get(pf_touches, _index) <= pf_max_touches
    _eligible

pf_find_best(_dir, _exclude_id) =>
    int _best_index = -1
    float _best_rank = -1000000.0
    if array.size(pf_ids) > 0
        for _i = 0 to array.size(pf_ids) - 1
            _eligible = array.get(pf_dirs, _i) == _dir and array.get(pf_active_zones, _i) and not array.get(pf_consumed, _i) and array.get(pf_touches, _i) <= pf_max_touches and array.get(pf_ids, _i) != _exclude_id
            if _eligible
                _top = array.get(pf_tops, _i)
                _bottom = array.get(pf_bottoms, _i)
                _distance = close > _top ? close - _top : close < _bottom ? _bottom - close : 0.0
                _distance_atr = _distance / math.max(pf_signal_atr, syminfo.mintick)
                _correct_side = _dir == 1 ? close >= _bottom : close <= _top
                _rank = array.get(pf_qualities, _i) * 10.0 - _distance_atr * 12.0 - array.get(pf_touches, _i) * 20.0
                if _correct_side and _distance_atr <= pf_max_distance_atr and _rank > _best_rank
                    _best_rank := _rank
                    _best_index := _i
    [_best_index, _best_rank]

pf_overlap_bonus(_index) =>
    int _bonus = 0
    if _index >= 0 and array.size(pf_ids) > 1
        _dir = array.get(pf_dirs, _index)
        _top = array.get(pf_tops, _index)
        _bottom = array.get(pf_bottoms, _index)
        _source = array.get(pf_sources, _index)
        bool _independent_overlap = false
        for _i = 0 to array.size(pf_ids) - 1
            if _i != _index and array.get(pf_active_zones, _i) and array.get(pf_dirs, _i) == _dir and array.get(pf_sources, _i) != _source
                _other_top = array.get(pf_tops, _i)
                _other_bottom = array.get(pf_bottoms, _i)
                if _top >= _other_bottom and _bottom <= _other_top
                    _independent_overlap := true
        _bonus := _independent_overlap ? 3 : 0
    _bonus

pf_consume_zone(_id) =>
    _index = pf_id_index(_id)
    if _index >= 0
        array.set(pf_consumed, _index, true)
        array.set(pf_active_zones, _index, false)

pf_source_for_id(_id) =>
    _index = pf_id_index(_id)
    _index >= 0 ? array.get(pf_sources, _index) : 'None'

pf_status_for_id(_id) =>
    _index = pf_id_index(_id)
    _status = 'None'
    if _index >= 0
        _status := array.get(pf_consumed, _index) ? 'Consumed' : not array.get(pf_active_zones, _index) ? 'Invalidated' : array.get(pf_touches, _index) == 0 ? 'Fresh' : 'Tested'
    _status

// Register currently available native zones. The source engines remain the
// authority for creating their own zones; Focus stores immutable snapshots.
if barstate.isconfirmed
    if array.size(ob_type) > 0
        for _i = 0 to array.size(ob_type) - 1
            _dir = array.get(ob_type, _i)
            _id = 'SOB:' + str.tostring(array.get(ob_left, _i)) + ':' + str.tostring(_dir)
            pf_register_zone(_id, _dir, array.get(ob_top, _i), array.get(ob_btm, _i), 'Swing OB', 25)

    if array.size(iob_type) > 0
        for _i = 0 to array.size(iob_type) - 1
            _dir = array.get(iob_type, _i)
            _id = 'IOB:' + str.tostring(array.get(iob_left, _i)) + ':' + str.tostring(_dir)
            pf_register_zone(_id, _dir, array.get(iob_top, _i), array.get(iob_btm, _i), 'Internal OB', 18)

    if array.size(demand_zones_s1) > 0
        for _i = 0 to array.size(demand_zones_s1) - 1
            if array.get(demand_zones_s1_active, _i)
                _s1 = array.get(demand_zones_s1, _i)
                _top = _s1
                _bottom = _s1 - pf_signal_atr * 0.50
                if _i < array.size(demand_zones_box)
                    _box = array.get(demand_zones_box, _i)
                    if not na(_box)
                        _top := box.get_top(_box)
                        _bottom := box.get_bottom(_box)
                _id = 'DSD:' + str.tostring(array.get(demand_zones_time, _i))
                pf_register_zone(_id, 1, _top, _bottom, 'Demand', 23)

    if array.size(supply_zones_s1) > 0
        for _i = 0 to array.size(supply_zones_s1) - 1
            if array.get(supply_zones_s1_active, _i)
                _s1 = array.get(supply_zones_s1, _i)
                _top = _s1 + pf_signal_atr * 0.50
                _bottom = _s1
                if _i < array.size(supply_zones_box)
                    _box = array.get(supply_zones_box, _i)
                    if not na(_box)
                        _top := box.get_top(_box)
                        _bottom := box.get_bottom(_box)
                _id = 'DSS:' + str.tostring(array.get(supply_zones_time, _i))
                pf_register_zone(_id, -1, _top, _bottom, 'Supply', 23)

    if array.size(pivotHigh) > 0
        for _i = 0 to array.size(pivotHigh) - 1
            _box = array.get(pivotHigh, _i)
            _dir = array.get(highBull, _i) ? 1 : -1
            if not na(_box)
                _top = box.get_top(_box)
                _bottom = box.get_bottom(_box)
                _id = 'PIVH:' + str.tostring(box.get_left(_box)) + ':' + str.tostring(_dir)
                pf_register_zone(_id, _dir, _top, _bottom, 'Pivot S/R', 17)

    if array.size(pivotLows) > 0
        for _i = 0 to array.size(pivotLows) - 1
            _box = array.get(pivotLows, _i)
            _dir = array.get(lowsBull, _i) ? 1 : -1
            if not na(_box)
                _top = box.get_top(_box)
                _bottom = box.get_bottom(_box)
                _id = 'PIVL:' + str.tostring(box.get_left(_box)) + ':' + str.tostring(_dir)
                pf_register_zone(_id, _dir, _top, _bottom, 'Pivot S/R', 17)

    if bullish_fvg_cnd and array.size(bullish_fvg_max) > 0 and array.size(bullish_fvg_min) > 0
        _max_box = array.get(bullish_fvg_max, 0)
        _min_box = array.get(bullish_fvg_min, 0)
        _id = 'BFVG:' + str.tostring(box.get_left(_max_box))
        pf_register_zone(_id, 1, box.get_top(_max_box), box.get_bottom(_min_box), 'Bullish FVG', 19)

    if bearish_fvg_cnd and array.size(bearish_fvg_max) > 0 and array.size(bearish_fvg_min) > 0
        _max_box = array.get(bearish_fvg_max, 0)
        _min_box = array.get(bearish_fvg_min, 0)
        _id = 'SFVG:' + str.tostring(box.get_left(_max_box))
        pf_register_zone(_id, -1, box.get_top(_max_box), box.get_bottom(_min_box), 'Bearish FVG', 19)

// Registry lifecycle: confirmed invalidation, expiry, and edge-triggered touch.
if barstate.isconfirmed and array.size(pf_ids) > 0
    for _i = 0 to array.size(pf_ids) - 1
        if array.get(pf_active_zones, _i)
            _dir = array.get(pf_dirs, _i)
            _top = array.get(pf_tops, _i)
            _bottom = array.get(pf_bottoms, _i)
            _expired = bar_index - array.get(pf_created_bars, _i) > pf_zone_expiry
            _invalid = _dir == 1 ? close < _bottom : close > _top
            _inside = low <= _top and high >= _bottom
            _was_inside = array.get(pf_inside_zones, _i)
            if _inside and not _was_inside and bar_index > array.get(pf_created_bars, _i)
                array.set(pf_touches, _i, array.get(pf_touches, _i) + 1)
                array.set(pf_last_touch_bars, _i, bar_index)
            array.set(pf_inside_zones, _i, _inside)
            if _expired or _invalid
                array.set(pf_active_zones, _i, false)

// Locked primary/backup views. Valid locks never jump to a newly closer zone.
var string pf_primary_buy_id = ''
var string pf_backup_buy_id = ''
var string pf_primary_sell_id = ''
var string pf_backup_sell_id = ''

if barstate.isconfirmed
    if not pf_id_eligible(pf_primary_buy_id)
        pf_primary_buy_id := pf_id_eligible(pf_backup_buy_id) ? pf_backup_buy_id : ''
        pf_backup_buy_id := ''
    if not pf_id_eligible(pf_primary_sell_id)
        pf_primary_sell_id := pf_id_eligible(pf_backup_sell_id) ? pf_backup_sell_id : ''
        pf_backup_sell_id := ''

    if pf_primary_buy_id == ''
        [_index, _rank] = pf_find_best(1, '')
        if _index >= 0
            pf_primary_buy_id := array.get(pf_ids, _index)
    if pf_backup_buy_id == ''
        [_index, _rank] = pf_find_best(1, pf_primary_buy_id)
        if _index >= 0
            pf_backup_buy_id := array.get(pf_ids, _index)

    if pf_primary_sell_id == ''
        [_index, _rank] = pf_find_best(-1, '')
        if _index >= 0
            pf_primary_sell_id := array.get(pf_ids, _index)
    if pf_backup_sell_id == ''
        [_index, _rank] = pf_find_best(-1, pf_primary_sell_id)
        if _index >= 0
            pf_backup_sell_id := array.get(pf_ids, _index)

pf_prior_low = ta.lowest(low[1], pf_liquidity_lookback)
pf_prior_high = ta.highest(high[1], pf_liquidity_lookback)
pf_buy_sweep_now = low < pf_prior_low and close > pf_prior_low
pf_sell_sweep_now = high > pf_prior_high and close < pf_prior_high

pf_range = math.max(high - low, syminfo.mintick)
pf_body = math.abs(close - open)
pf_bull_displacement = close > open and pf_body >= pf_signal_atr * pf_displacement_atr and (close - low) / pf_range >= 0.65
pf_bear_displacement = close < open and pf_body >= pf_signal_atr * pf_displacement_atr and (high - close) / pf_range >= 0.65
pf_bull_structure_event = bull_ichoch_alert or bull_ibos_alert or bull_choch_alert or bull_bos_alert
pf_bear_structure_event = bear_ichoch_alert or bear_ibos_alert or bear_choch_alert or bear_bos_alert

// BULB exits are clean one-bar events. Original moving BULB labels remain.
pf_bulb_buy_event = barstate.isconfirmed and isOversold[1] and not isOversold
pf_bulb_sell_event = barstate.isconfirmed and isOverbought[1] and not isOverbought
pf_buy_bulb_recent = nz(ta.barssince(pf_bulb_buy_event), 100000) <= pf_confirm_window
pf_sell_bulb_recent = nz(ta.barssince(pf_bulb_sell_event), 100000) <= pf_confirm_window

pf_dashboard_bull_count = (macdLabel == dashboard_bull_css ? 1 : 0) + (stochLabel == dashboard_bull_css ? 1 : 0) + (vortexLabel == dashboard_bull_css ? 1 : 0) + (momLabel == dashboard_bull_css ? 1 : 0) + (rsiLabel == dashboard_bull_css ? 1 : 0) + (psarLabel == dashboard_bull_css ? 1 : 0) + (dmiLabel == dashboard_bull_css ? 1 : 0) + (mfiLabel == dashboard_bull_css ? 1 : 0) + (fisherLabel == dashboard_bull_css ? 1 : 0)
pf_dashboard_bear_count = (macdLabel == dashboard_bear_css ? 1 : 0) + (stochLabel == dashboard_bear_css ? 1 : 0) + (vortexLabel == dashboard_bear_css ? 1 : 0) + (momLabel == dashboard_bear_css ? 1 : 0) + (rsiLabel == dashboard_bear_css ? 1 : 0) + (psarLabel == dashboard_bear_css ? 1 : 0) + (dmiLabel == dashboard_bear_css ? 1 : 0) + (mfiLabel == dashboard_bear_css ? 1 : 0) + (fisherLabel == dashboard_bear_css ? 1 : 0)
pf_buy_secondary = pf_buy_bulb_recent or pf_dashboard_bull_count >= 6 or data
pf_sell_secondary = pf_sell_bulb_recent or pf_dashboard_bear_count >= 6 or dtat

// Two independent setup state machines. 0=watching, 1=setup.
var int pf_buy_state = 0
var int pf_sell_state = 0
var string pf_buy_setup_id = ''
var string pf_sell_setup_id = ''
var int pf_buy_setup_bar = na
var int pf_sell_setup_bar = na
var float pf_buy_setup_top = na
var float pf_buy_setup_bottom = na
var float pf_sell_setup_top = na
var float pf_sell_setup_bottom = na
var bool pf_buy_setup_sweep = false
var bool pf_sell_setup_sweep = false
var int pf_last_buy_score = 0
var int pf_last_sell_score = 0

pf_primary_buy_index = pf_id_index(pf_primary_buy_id)
pf_primary_sell_index = pf_id_index(pf_primary_sell_id)
bool pf_primary_buy_touched = false
bool pf_primary_sell_touched = false
if pf_primary_buy_index >= 0
    pf_primary_buy_touched := array.get(pf_last_touch_bars, pf_primary_buy_index) == bar_index
if pf_primary_sell_index >= 0
    pf_primary_sell_touched := array.get(pf_last_touch_bars, pf_primary_sell_index) == bar_index

if pf_active and barstate.isconfirmed
    if pf_buy_state == 0 and pf_primary_buy_touched
        pf_buy_state := 1
        pf_buy_setup_id := pf_primary_buy_id
        pf_buy_setup_bar := bar_index
        pf_buy_setup_top := array.get(pf_tops, pf_primary_buy_index)
        pf_buy_setup_bottom := array.get(pf_bottoms, pf_primary_buy_index)
        pf_buy_setup_sweep := pf_buy_sweep_now or (low < pf_buy_setup_bottom and close > pf_buy_setup_bottom)
        if pf_show_setups
            _setup_label = label.new(bar_index, pf_buy_setup_bottom, 'SETUP', yloc=yloc.price, style=label.style_label_up, color=color.new(theme_bull_border_css, 35), textcolor=dashboard_text_css, size=size.tiny)
            label.set_tooltip(_setup_label, 'BUY setup\n' + pf_source_for_id(pf_buy_setup_id) + '\nWaiting for confirmed displacement or CHoCH/BOS')

    if pf_sell_state == 0 and pf_primary_sell_touched
        pf_sell_state := 1
        pf_sell_setup_id := pf_primary_sell_id
        pf_sell_setup_bar := bar_index
        pf_sell_setup_top := array.get(pf_tops, pf_primary_sell_index)
        pf_sell_setup_bottom := array.get(pf_bottoms, pf_primary_sell_index)
        pf_sell_setup_sweep := pf_sell_sweep_now or (high > pf_sell_setup_top and close < pf_sell_setup_top)
        if pf_show_setups
            _setup_label = label.new(bar_index, pf_sell_setup_top, 'SETUP', yloc=yloc.price, style=label.style_label_down, color=color.new(theme_bear_border_css, 35), textcolor=dashboard_text_css, size=size.tiny)
            label.set_tooltip(_setup_label, 'SELL setup\n' + pf_source_for_id(pf_sell_setup_id) + '\nWaiting for confirmed displacement or CHoCH/BOS')

    if pf_buy_state == 1
        pf_buy_setup_sweep := pf_buy_setup_sweep or pf_buy_sweep_now or (low < pf_buy_setup_bottom and close > pf_buy_setup_bottom)
        if bar_index - pf_buy_setup_bar > pf_confirm_window or close < pf_buy_setup_bottom or not pf_id_eligible(pf_buy_setup_id)
            pf_buy_state := 0
            pf_buy_setup_id := ''

    if pf_sell_state == 1
        pf_sell_setup_sweep := pf_sell_setup_sweep or pf_sell_sweep_now or (high > pf_sell_setup_top and close < pf_sell_setup_top)
        if bar_index - pf_sell_setup_bar > pf_confirm_window or close > pf_sell_setup_top or not pf_id_eligible(pf_sell_setup_id)
            pf_sell_state := 0
            pf_sell_setup_id := ''

pf_buy_focus = false
pf_sell_focus = false
float pf_buy_focus_stop = na
float pf_sell_focus_stop = na

if pf_active and barstate.isconfirmed
    if pf_buy_state == 1 and bar_index > pf_buy_setup_bar
        _zone_index = pf_id_index(pf_buy_setup_id)
        _reclaim = close > math.avg(pf_buy_setup_top, pf_buy_setup_bottom)
        _confirmation = _reclaim and (pf_bull_structure_event or pf_bull_displacement)
        if _zone_index >= 0 and _confirmation
            _htf_score = (pf_fast_bias == 1 ? 10 : 0) + (pf_slow_bias == 1 ? 10 : 0)
            _zone_score = math.min(25, array.get(pf_qualities, _zone_index) + pf_overlap_bonus(_zone_index))
            _liquidity_score = pf_buy_setup_sweep ? 20 : 0
            _structure_score = pf_bull_structure_event ? 20 : pf_bull_displacement ? 15 : 0
            _discount_top = 0.95 * trail_dn + 0.05 * trail_up
            _location_score = math.avg(pf_buy_setup_top, pf_buy_setup_bottom) <= _discount_top ? 10 : 0
            _secondary_score = pf_buy_secondary ? 5 : 0
            pf_last_buy_score := _htf_score + _zone_score + _liquidity_score + _structure_score + _location_score + _secondary_score
            if pf_last_buy_score >= pf_score_threshold
                pf_buy_focus := true
                pf_buy_focus_stop := pf_buy_setup_bottom - pf_signal_atr * pf_validation_buffer_atr
                _tooltip = 'A+ BUY | Score ' + str.tostring(pf_last_buy_score) + '/100\nAOI: ' + array.get(pf_sources, _zone_index) + ' (' + pf_status_for_id(pf_buy_setup_id) + ')\nHTF: ' + str.tostring(_htf_score) + '/20 | Zone: ' + str.tostring(_zone_score) + '/25\nLiquidity: ' + str.tostring(_liquidity_score) + '/20 | Structure: ' + str.tostring(_structure_score) + '/20\nLocation: ' + str.tostring(_location_score) + '/10 | Secondary: ' + str.tostring(_secondary_score) + '/5'
                if pf_show_focus
                    _focus_label = label.new(bar_index, low - pf_signal_atr * 0.35, 'A+ BUY\n' + str.tostring(pf_last_buy_score), yloc=yloc.price, style=label.style_label_up, color=theme_bull_border_css, textcolor=dashboard_text_css, size=size.large)
                    label.set_tooltip(_focus_label, _tooltip)
                pf_consume_zone(pf_buy_setup_id)
                pf_primary_buy_id := ''
                pf_buy_state := 0
                pf_buy_setup_id := ''

    if pf_sell_state == 1 and bar_index > pf_sell_setup_bar
        _zone_index = pf_id_index(pf_sell_setup_id)
        _reclaim = close < math.avg(pf_sell_setup_top, pf_sell_setup_bottom)
        _confirmation = _reclaim and (pf_bear_structure_event or pf_bear_displacement)
        if _zone_index >= 0 and _confirmation
            _htf_score = (pf_fast_bias == -1 ? 10 : 0) + (pf_slow_bias == -1 ? 10 : 0)
            _zone_score = math.min(25, array.get(pf_qualities, _zone_index) + pf_overlap_bonus(_zone_index))
            _liquidity_score = pf_sell_setup_sweep ? 20 : 0
            _structure_score = pf_bear_structure_event ? 20 : pf_bear_displacement ? 15 : 0
            _premium_bottom = 0.95 * trail_up + 0.05 * trail_dn
            _location_score = math.avg(pf_sell_setup_top, pf_sell_setup_bottom) >= _premium_bottom ? 10 : 0
            _secondary_score = pf_sell_secondary ? 5 : 0
            pf_last_sell_score := _htf_score + _zone_score + _liquidity_score + _structure_score + _location_score + _secondary_score
            if pf_last_sell_score >= pf_score_threshold
                pf_sell_focus := true
                pf_sell_focus_stop := pf_sell_setup_top + pf_signal_atr * pf_validation_buffer_atr
                _tooltip = 'A+ SELL | Score ' + str.tostring(pf_last_sell_score) + '/100\nAOI: ' + array.get(pf_sources, _zone_index) + ' (' + pf_status_for_id(pf_sell_setup_id) + ')\nHTF: ' + str.tostring(_htf_score) + '/20 | Zone: ' + str.tostring(_zone_score) + '/25\nLiquidity: ' + str.tostring(_liquidity_score) + '/20 | Structure: ' + str.tostring(_structure_score) + '/20\nLocation: ' + str.tostring(_location_score) + '/10 | Secondary: ' + str.tostring(_secondary_score) + '/5'
                if pf_show_focus
                    _focus_label = label.new(bar_index, high + pf_signal_atr * 0.35, 'A+ SELL\n' + str.tostring(pf_last_sell_score), yloc=yloc.price, style=label.style_label_down, color=theme_bear_border_css, textcolor=dashboard_text_css, size=size.large)
                    label.set_tooltip(_focus_label, _tooltip)
                pf_consume_zone(pf_sell_setup_id)
                pf_primary_sell_id := ''
                pf_sell_state := 0
                pf_sell_setup_id := ''

alertcondition(pf_buy_focus, 'Precision Focus A+ BUY', 'Precision Focus A+ BUY on {{ticker}} {{interval}} at {{close}}')
alertcondition(pf_sell_focus, 'Precision Focus A+ SELL', 'Precision Focus A+ SELL on {{ticker}} {{interval}} at {{close}}')

// Conservative next-bar-open outcome tracker with structural invalidation,
// first-hit ordering, ambiguous-bar accounting, MFE, and MAE.
var pf_val_dirs = array.new_int(0)
var pf_val_entries = array.new_float(0)
var pf_val_stops = array.new_float(0)
var pf_val_risks = array.new_float(0)
var pf_val_t1s = array.new_float(0)
var pf_val_t2s = array.new_float(0)
var pf_val_borns = array.new_int(0)
var pf_val_active = array.new_bool(0)
var pf_val_t1_hit = array.new_bool(0)
var pf_val_mfe = array.new_float(0)
var pf_val_mae = array.new_float(0)

var int pf_pending_buy_bar = na
var int pf_pending_sell_bar = na
var float pf_pending_buy_stop = na
var float pf_pending_sell_stop = na
var int pf_total_outcomes = 0
var int pf_t1_outcomes = 0
var int pf_t2_outcomes = 0
var int pf_stopped_outcomes = 0
var int pf_ambiguous_outcomes = 0
var int pf_expired_outcomes = 0
var float pf_closed_mfe_sum = 0.0
var float pf_closed_mae_sum = 0.0

pf_add_validation(_dir, _entry, _stop) =>
    _fallback_risk = math.max(pf_signal_atr, syminfo.mintick * 10)
    _risk = _dir == 1 ? _entry - _stop : _stop - _entry
    _safe_risk = _risk > syminfo.mintick ? _risk : _fallback_risk
    _safe_stop = _dir == 1 ? _entry - _safe_risk : _entry + _safe_risk
    array.push(pf_val_dirs, _dir)
    array.push(pf_val_entries, _entry)
    array.push(pf_val_stops, _safe_stop)
    array.push(pf_val_risks, _safe_risk)
    array.push(pf_val_t1s, _dir == 1 ? _entry + _safe_risk : _entry - _safe_risk)
    array.push(pf_val_t2s, _dir == 1 ? _entry + _safe_risk * 2.0 : _entry - _safe_risk * 2.0)
    array.push(pf_val_borns, bar_index)
    array.push(pf_val_active, true)
    array.push(pf_val_t1_hit, false)
    array.push(pf_val_mfe, 0.0)
    array.push(pf_val_mae, 0.0)
    if array.size(pf_val_dirs) > 200
        array.shift(pf_val_dirs)
        array.shift(pf_val_entries)
        array.shift(pf_val_stops)
        array.shift(pf_val_risks)
        array.shift(pf_val_t1s)
        array.shift(pf_val_t2s)
        array.shift(pf_val_borns)
        array.shift(pf_val_active)
        array.shift(pf_val_t1_hit)
        array.shift(pf_val_mfe)
        array.shift(pf_val_mae)

if pf_validation_enabled
    if pf_buy_focus
        pf_pending_buy_bar := bar_index
        pf_pending_buy_stop := pf_buy_focus_stop
    if pf_sell_focus
        pf_pending_sell_bar := bar_index
        pf_pending_sell_stop := pf_sell_focus_stop

    if not na(pf_pending_buy_bar) and bar_index > pf_pending_buy_bar
        pf_add_validation(1, open, pf_pending_buy_stop)
        pf_pending_buy_bar := na
        pf_pending_buy_stop := na
    if not na(pf_pending_sell_bar) and bar_index > pf_pending_sell_bar
        pf_add_validation(-1, open, pf_pending_sell_stop)
        pf_pending_sell_bar := na
        pf_pending_sell_stop := na

    if barstate.isconfirmed and array.size(pf_val_dirs) > 0
        for _i = 0 to array.size(pf_val_dirs) - 1
            if array.get(pf_val_active, _i)
                _dir = array.get(pf_val_dirs, _i)
                _entry = array.get(pf_val_entries, _i)
                _stop = array.get(pf_val_stops, _i)
                _risk = array.get(pf_val_risks, _i)
                _t1 = array.get(pf_val_t1s, _i)
                _t2 = array.get(pf_val_t2s, _i)
                _favorable = _dir == 1 ? high - _entry : _entry - low
                _adverse = _dir == 1 ? _entry - low : high - _entry
                _mfe = math.max(array.get(pf_val_mfe, _i), _favorable / _risk)
                _mae = math.max(array.get(pf_val_mae, _i), _adverse / _risk)
                array.set(pf_val_mfe, _i, _mfe)
                array.set(pf_val_mae, _i, _mae)
                _stop_hit = _dir == 1 ? low <= _stop : high >= _stop
                _t1_hit_now = _dir == 1 ? high >= _t1 : low <= _t1
                _t2_hit_now = _dir == 1 ? high >= _t2 : low <= _t2
                _ambiguous = _stop_hit and (_t1_hit_now or _t2_hit_now)
                _had_t1 = array.get(pf_val_t1_hit, _i)
                _closed = false
                if _ambiguous
                    pf_ambiguous_outcomes += 1
                    pf_stopped_outcomes += 1
                    _closed := true
                else if _stop_hit
                    pf_stopped_outcomes += 1
                    _closed := true
                else if _t2_hit_now
                    _had_t1 := true
                    array.set(pf_val_t1_hit, _i, true)
                    pf_t2_outcomes += 1
                    _closed := true
                else if _t1_hit_now and not _had_t1
                    array.set(pf_val_t1_hit, _i, true)
                    _had_t1 := true
                else if bar_index - array.get(pf_val_borns, _i) >= pf_validation_horizon
                    pf_expired_outcomes += 1
                    _closed := true
                if _closed
                    array.set(pf_val_active, _i, false)
                    pf_total_outcomes += 1
                    if _had_t1 and not _ambiguous
                        pf_t1_outcomes += 1
                    pf_closed_mfe_sum += _mfe
                    pf_closed_mae_sum += _mae

pf_t1_rate = pf_total_outcomes > 0 ? pf_t1_outcomes * 100.0 / pf_total_outcomes : na
pf_t2_rate = pf_total_outcomes > 0 ? pf_t2_outcomes * 100.0 / pf_total_outcomes : na
pf_avg_mfe = pf_total_outcomes > 0 ? pf_closed_mfe_sum / pf_total_outcomes : na
pf_avg_mae = pf_total_outcomes > 0 ? pf_closed_mae_sum / pf_total_outcomes : na

var pf_table = table.new(pf_table_position, 2, 10, border_width=1)
if barstate.islast and pf_show_table
    _support_text = pf_chart_supported ? timeframe.period : 'USE 1m CHART'
    table.cell(pf_table, 0, 0, 'Precision Focus v3', bgcolor=dashboard_header_css, text_color=dashboard_text_css)
    table.cell(pf_table, 1, 0, _support_text, bgcolor=dashboard_header_css, text_color=dashboard_text_css)
    table.cell(pf_table, 0, 1, 'HTF ' + pf_fast_tf + '/' + pf_slow_tf, text_color=theme_text_css)
    table.cell(pf_table, 1, 1, str.tostring(pf_fast_bias) + ' / ' + str.tostring(pf_slow_bias), text_color=theme_text_css)
    table.cell(pf_table, 0, 2, 'BUY AOI', text_color=theme_text_css)
    table.cell(pf_table, 1, 2, pf_source_for_id(pf_primary_buy_id) + ' | ' + pf_status_for_id(pf_primary_buy_id), text_color=theme_bull_border_css)
    table.cell(pf_table, 0, 3, 'SELL AOI', text_color=theme_text_css)
    table.cell(pf_table, 1, 3, pf_source_for_id(pf_primary_sell_id) + ' | ' + pf_status_for_id(pf_primary_sell_id), text_color=theme_bear_border_css)
    table.cell(pf_table, 0, 4, 'Last score B/S', text_color=theme_text_css)
    table.cell(pf_table, 1, 4, str.tostring(pf_last_buy_score) + ' / ' + str.tostring(pf_last_sell_score), text_color=theme_text_css)
    table.cell(pf_table, 0, 5, 'Closed outcomes', text_color=theme_text_css)
    table.cell(pf_table, 1, 5, str.tostring(pf_total_outcomes), text_color=theme_text_css)
    table.cell(pf_table, 0, 6, '1R / 2R', text_color=theme_text_css)
    table.cell(pf_table, 1, 6, (na(pf_t1_rate) ? 'n/a' : str.tostring(pf_t1_rate, '#.0') + '%') + ' / ' + (na(pf_t2_rate) ? 'n/a' : str.tostring(pf_t2_rate, '#.0') + '%'), text_color=theme_text_css)
    table.cell(pf_table, 0, 7, 'Stop / Ambiguous', text_color=theme_text_css)
    table.cell(pf_table, 1, 7, str.tostring(pf_stopped_outcomes) + ' / ' + str.tostring(pf_ambiguous_outcomes), text_color=theme_text_css)
    table.cell(pf_table, 0, 8, 'Expired', text_color=theme_text_css)
    table.cell(pf_table, 1, 8, str.tostring(pf_expired_outcomes), text_color=theme_text_css)
    table.cell(pf_table, 0, 9, 'Avg MFE / MAE', text_color=theme_text_css)
    table.cell(pf_table, 1, 9, (na(pf_avg_mfe) ? 'n/a' : str.tostring(pf_avg_mfe, '#.00') + 'R') + ' / ' + (na(pf_avg_mae) ? 'n/a' : str.tostring(pf_avg_mae, '#.00') + 'R'), text_color=theme_text_css)
if barstate.islast and not pf_show_table
    table.clear(pf_table, 0, 0, 1, 9)
